{
  "keys": [
    {"key": "camera", "permissions": ["android.permission.CAMERA"]},
    {"key": "location", "permissions": ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_BACKGROUND_LOCATION", "android.permission.ACCESS_MEDIA_LOCATION"]},
    {"key": "microphone", "permissions": ["android.permission.RECORD_AUDIO"]},
    {"key": "contacts", "permissions": ["android.permission.READ_CONTACTS", "android.permission.WRITE_CONTACTS"]}
  ],
  "policy": {
    "none": [],
    "seeded": [
      {"package_name": "io.element.android.x", "camera": "deny", "microphone": "deny"},
      {"package_name": "org.example.maps", "location": "deny", "contacts": "deny"}
    ]
  },
  "report": {
    "installed_apps": [
      {"package_name": "io.element.android.x", "label": "Element X", "preinstalled": false, "access": {"camera": "admin_denied", "microphone": "refused", "contacts": "requested", "full_screen": "denied"}},
      {"package_name": "org.example.maps", "label": "Maps", "preinstalled": false, "access": {"location": "admin_denied", "contacts": "admin_denied"}},
      {"package_name": "org.example.notes", "label": "Notes", "preinstalled": false, "access": {"camera": "requested", "location": "requested", "microphone": "requested", "contacts": "requested", "exact_alarm": "granted"}},
      {"package_name": "org.example.gallery", "label": "Gallery", "preinstalled": false, "access": {"location": "admin_denied"}}
    ]
  },
  "clean": [
    {"access": {"camera": "admin_denied", "location": "refused", "microphone": "requested", "contacts": "requested", "manage_media": "unknown"}, "kept": {"camera": "admin_denied", "location": "refused", "microphone": "requested", "contacts": "requested", "manage_media": "unknown"}},
    {"access": {"camera": "denied", "location": "granted", "microphone": 7, "contacts": "admin_denied", "bluetooth": "requested"}, "kept": {"contacts": "admin_denied"}},
    {"access": {"location": "admin_denied"}, "kept": {"location": "admin_denied"}},
    {"access": {"network": "requested"}, "kept": null},
    {"access": "requested", "kept": null},
    {"access": ["camera"], "kept": null}
  ],
  "never": ["me.vibb.launcher", "me.vibb.launcher.debug", "me.vibb.music", "me.vibb.music.debug"]
}
