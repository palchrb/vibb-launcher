# Copy to .env and fill in before running.

# Bootstrap admin account, created on first run only (ignored afterward).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# Optional overrides - defaults shown.
# DATABASE_URL=sqlite://data/kidphone.db
# BIND_ADDR=127.0.0.1:3100

# Only set this for local LAN/HTTP testing - session cookies won't be sent
# over plain HTTP otherwise. Never set this in production (HTTPS via
# Tailscale Funnel or similar).
# INSECURE_COOKIES=true

# Optional: FCM nudges for the phones (handy step 7, DEPLOY.md "FCM (optional)"). Path to an
# FCM-only service-account JSON key - outside data/ (backups copy data/), mode 600, owned by the
# service user; the server refuses anything else and then runs without FCM (phones use SSE).
# FCM_SERVICE_ACCOUNT_FILE=/etc/kid-phone-server/fcm-service-account.json

# Seconds between keepalives on the SSE command stream (only phones without working FCM hold it).
# SSE_KEEPALIVE_SECS=120
