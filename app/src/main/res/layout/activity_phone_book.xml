<?xml version="1.0" encoding="utf-8"?>
<!-- Phone book (mockup PhoneBook.dc.html): back button + title, then the contacts as a grid of
     round avatars. Tapping one opens ContactSheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/phone_book_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_kid_circle"
            android:backgroundTint="@color/kid_back_button"
            android:contentDescription="@string/kid_back_home"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kid_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/calls_phone_book"
            android:textColor="@color/kid_ink"
            android:textSize="24sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/phone_book_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/kid_ink_dim"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_book_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />
</LinearLayout>
