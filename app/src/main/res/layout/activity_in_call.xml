<?xml version="1.0" encoding="utf-8"?>
<!-- calls.InCallActivity: who, status/timer, and four large buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/in_call_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/in_call_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="20sp" />

    <Button
        android:id="@+id/in_call_answer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="48dp"
        android:text="@string/calls_answer"
        android:textSize="22sp" />

    <Button
        android:id="@+id/in_call_hang_up"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:text="@string/calls_hang_up"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/in_call_speaker"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/calls_speaker"
            android:textSize="18sp" />

        <Button
            android:id="@+id/in_call_mute"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/calls_mute"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
