<?xml version="1.0" encoding="utf-8"?>
<!-- The Parent code dialog on the PIN lock: the override PIN; errors show here, not as a toast
     (DISALLOW_CREATE_WINDOWS is set while locked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/parent_code_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:textColor="#000000"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/parent_code_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textColor="#C92A2A"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
