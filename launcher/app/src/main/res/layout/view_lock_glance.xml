<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN lock's glance page (design 25, mockup LockGlance.dc.html A and B; lock.GlancePanel, pure
     lock.LockGlance): the clock, the date, the music tile while something plays (full, or compact when
     rows compete for the height - lock.glanceFit), up to three notification rows and the "more" line,
     "Lås opp" to the keypad and the bottom row: the lock's emergency call and the flashlight (design
     41). The page never scrolls. Part of the lock:
     nothing here opens an app, a setting or a notification - a row only leads to the keypad. The root
     only blocks touches to the keypad below - no node for TalkBack (qa-21-step4-code L7). The fit and
     the widths at 320/360/411 dp are pinned by LockGlanceLayoutTest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock_glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <TextClock
        android:id="@+id/lock_glance_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/kid_ink"
        android:textSize="56sp" />

    <!-- Centred also when it wraps (font scale 2.0: "Wednesday, / October 14", emulator round N8). -->
    <TextClock
        android:id="@+id/lock_glance_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/kid_core_dim"
        android:textSize="14sp" />

    <!-- The full tile: step 4's (72 dp art, item, entry, 5 dp progress, previous / play / next), with
         the time line under the bar (r6 §2). -->
    <LinearLayout
        android:id="@+id/lock_media_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_music_tile"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:id="@+id/lock_media_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_music_art_large"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/lock_media_glyph"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/app_glyph_music_note"
                    android:tint="@color/kid_core" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lock_media_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_extrabold"
                    android:maxLines="2"
                    android:textColor="@color/kid_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lock_media_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_bold"
                    android:maxLines="1"
                    android:textColor="@color/kid_core_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/lock_media_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="1000"
            android:progressDrawable="@drawable/bg_music_progress" />

        <!-- "4:48 · 25:36" (r6 §2), ticking with the bar. Tabular figures in a width its parent fixes
             (match_parent) and one line: a tick swaps the text without a layout. The bar's content
             description says it to TalkBack. -->
        <TextView
            android:id="@+id/lock_media_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/kid_core_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/lock_media_previous"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_music_control"
                android:contentDescription="@string/music_previous"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_previous"
                android:tint="@color/kid_core" />

            <ImageButton
                android:id="@+id/lock_media_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_music_play"
                android:padding="19dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_pause"
                android:tint="@color/kid_ground" />

            <ImageButton
                android:id="@+id/lock_media_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_music_control"
                android:contentDescription="@string/music_next"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_next"
                android:tint="@color/kid_core" />
        </LinearLayout>
    </LinearLayout>

    <!-- The compact tile (mockup A): one row - 52 dp art, item, entry, a 3 dp progress bar under them
         and the time line under the bar (r6 §2, qa-r6 r6-5: never beside it), a 48 dp peach
         play/pause. -->
    <LinearLayout
        android:id="@+id/lock_media_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_glance_compact_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/lock_media_compact_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_music_art"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/lock_media_compact_glyph"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/app_glyph_music_note"
                android:tint="@color/kid_core" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lock_media_compact_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:textColor="@color/kid_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lock_media_compact_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="1"
                android:textColor="@color/kid_core_dim"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/lock_media_compact_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="1000"
                android:progressDrawable="@drawable/bg_music_progress" />

            <TextView
                android:id="@+id/lock_media_compact_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/kid_core_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/lock_media_compact_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_music_play"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_pause"
            android:tint="@color/kid_ground" />
    </LinearLayout>

    <!-- The rows (view_lock_glance_row.xml, added by the panel, 8 dp apart) and the "more" line right
         under them; 14 dp below the tile, 22 dp below the date without one (set by the panel). -->
    <LinearLayout
        android:id="@+id/lock_glance_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/lock_glance_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/lock_glance_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:minHeight="24dp"
            android:textColor="@color/kid_core_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/lock_glance_unlock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_lock_unlock"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_unlock"
            android:tint="@color/kid_ground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/lock_media_unlock"
            android:textColor="@color/kid_ground"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- The bottom row (design 41 §1.3): "Nødsamtale" centred as before and the flashlight at the
         end, beside it without pushing it off centre. Nødsamtale keeps the 48 dp target of design 34
         P7 (qa-34-s8-code N5; the row's margin gave the 4 dp) and the room for a 48 dp button on each
         side, so a long label at a large font wraps before it reaches the button; the button is no
         taller than it, so the row (the fit's fixed part) stays 50 dp. The flashlight is gone without a
         flash unit or when the torch is refused while LOCKED (§1.5). -->
    <FrameLayout
        android:id="@+id/lock_glance_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/lock_glance_emergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/pin_lock_emergency"
            android:textColor="@color/kid_emergency_text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/lock_glance_torch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_music_control"
            android:contentDescription="@string/lock_torch"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/torch_glyph_off"
            android:tint="@color/kid_core"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
