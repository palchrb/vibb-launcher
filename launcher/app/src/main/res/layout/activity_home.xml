<?xml version="1.0" encoding="utf-8"?>
<!-- Home (design 08-ui-polish.md, mockup Main.dc.html at 320x568 dp): no clock - the time is in
     Android's status bar above (fitsSystemWindows pads the content, the wallpaper is drawn under
     the bar) - then the parent's Home contacts as big round buttons, then the app grid (phone book
     first, Settings last). Sizes come from gridMetrics/contactRow. The mockup's 6 dp padding and
     14 dp gap under its drawn status row are Android's status bar here, so the contacts start
     right under the bar (emulator run 2026-10-06: the gap was too large). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:longClickable="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    tools:context=".ui.HomeActivity">

    <!-- Design 24b §1.3: while a parent-PIN window is open, "Open until 18:40 · Lock again" - our
         own UI, so it can't be dismissed or switched off like the notification. -->
    <LinearLayout
        android:id="@+id/home_window_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_home_window_banner"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_window_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_extrabold"
            android:maxLines="2"
            android:textColor="@color/kid_sheet_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/home_window_lock_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_window_lock_again"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/window_lock_again"
            android:textColor="@color/kid_core"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- While a call exists the contacts row gives way to this card (user request after the
         emulator run): avatar, "Call with <name> · mm:ss", "Tap to go back" - a tap brings our
         call screen back. -->
    <LinearLayout
        android:id="@+id/home_call_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_home_call_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/home_call_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/home_call_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="22sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_call_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_call_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/home_call_back"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Design 34 P4: a row that scrolls (more contacts than fit, contactRow) fades 16 dp at the
         edge it can scroll past; a row that fits never scrolls (contactItemPx), so it never fades. -->
    <HorizontalScrollView
        android:id="@+id/home_contacts_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fadingEdgeLength="16dp"
        android:fillViewport="true"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/home_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Vibb music's "Spilles nå" card (design 21 step 4), under the contacts row or the call card. -->
    <include
        android:id="@+id/home_music_card"
        layout="@layout/view_home_music_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Design 34 P4: the grid fades where it can scroll - 12 dp at the top, 32 dp at the bottom
         (FadingRecyclerView scales the one fadingEdgeLength per edge; HomeEdges.kt). -->
    <com.kidslauncher.mdm.ui.home.FadingRecyclerView
        android:id="@+id/home_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="32dp"
        android:paddingBottom="16dp"
        android:requiresFadingEdge="vertical"
        tools:listitem="@layout/item_kid_tile" />

</LinearLayout>
