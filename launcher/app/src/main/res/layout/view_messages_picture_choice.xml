<?xml version="1.0" encoding="utf-8"?>
<!-- The compose bar's "+" with a camera the parent allows (design 77 D11): Ta bilde or Velg bilde, built into the screen
     like the delete confirm (no system dialog). It takes the compose bar's place; Avbryt and Back close it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messages_picture_choice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/bg_messages_confirm"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/messages_picture_choice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:fontFamily="@font/nunito_extrabold"
        android:text="@string/messages_add_picture"
        android:textColor="@color/kid_core"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/messages_picture_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_messages_button"
            android:fontFamily="@font/nunito_extrabold"
            android:minHeight="48dp"
            android:text="@string/messages_take_picture"
            android:textAllCaps="false"
            android:textColor="@color/kid_core"
            android:textSize="16sp" />

        <Button
            android:id="@+id/messages_picture_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_messages_button"
            android:fontFamily="@font/nunito_extrabold"
            android:minHeight="48dp"
            android:text="@string/messages_choose_picture"
            android:textAllCaps="false"
            android:textColor="@color/kid_core"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/messages_picture_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_messages_button"
        android:fontFamily="@font/nunito_extrabold"
        android:minHeight="48dp"
        android:text="@string/messages_cancel"
        android:textAllCaps="false"
        android:textColor="@color/kid_core"
        android:textSize="16sp" />
</LinearLayout>
