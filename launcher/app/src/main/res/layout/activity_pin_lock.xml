<?xml version="1.0" encoding="utf-8"?>
<!-- lock.PinLockActivity's ground under the glance page (view_lock_glance.xml, over this): the prompt (read out for
     accessibility) and Emergency call (the tonal pill, at least 48 dp, design 34 P7), which the glance's own Emergency
     call clicks. Design 132: no keypad, dots, back arrow or Parent code - Android's PIN pad is the only unlock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <!-- The prompt (two lines at most, qa-21-step4-code L5 and design 25 QA Low 5). -->
    <FrameLayout
        android:id="@+id/pin_prompt_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/pin_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/pin_lock_prompt"
            android:textColor="@color/kid_ink"
            android:textSize="16sp" />
    </FrameLayout>

    <!-- Design 34 P7: the tonal pill (#3A1E24 under #FF8A8A, 6.6:1). The label
         wraps rather than cuts at a large font scale, and the pill grows with it. -->
    <LinearLayout
        android:id="@+id/pin_emergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pin_emergency_tonal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/pin_emergency_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_kid_phone"
            android:tint="@color/kid_emergency_text" />

        <TextView
            android:id="@+id/pin_emergency_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:text="@string/pin_lock_emergency"
            android:textColor="@color/kid_emergency_text"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
