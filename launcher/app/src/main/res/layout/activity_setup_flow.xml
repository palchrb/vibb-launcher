<?xml version="1.0" encoding="utf-8"?>
<!-- Design 114 §6.2: the setup flow - one step a screen, the parent's calm look (Nunito, the Settings colours); insets
     by fitsSystemWindows, as the launcher's other parent screens (edge-to-edge is enforced on 15+). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/setup_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:fontFamily="@font/nunito_bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_extrabold"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/setup_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_bold"
            android:lineSpacingMultiplier="1.15"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/setup_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/setup_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/setup_secondary"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="52dp" />

        <Button
            android:id="@+id/setup_tertiary"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="52dp" />
    </LinearLayout>
</ScrollView>
