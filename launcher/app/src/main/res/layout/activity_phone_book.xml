<?xml version="1.0" encoding="utf-8"?>
<!-- Phone book (mockup PhoneBook.dc.html): the shared header (include_kid_header), then the contacts as a grid of
     round avatars. Tapping one opens ContactSheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <include
        android:id="@+id/phone_book_header"
        layout="@layout/include_kid_header" />

    <TextView
        android:id="@+id/phone_book_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/kid_ink_dim"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_book_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />
</LinearLayout>
