<?xml version="1.0" encoding="utf-8"?>
<!-- The phone book as one list (design 79): the shared header (include_kid_header) with the contact request's "+" over
     its end, an info line, then the list of night rows (PhoneBookAdapter) on Dagen's plain night ground (kid_ground,
     2026-11-10; no wallpaper). The contact
     request form takes the list's place while it is open (view_contact_request_form). The page is edge to edge: the
     bottom padding takes the navigation bar or the keyboard, whichever is taller (PhoneBookActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_page_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/phone_book_header"
            layout="@layout/include_kid_header" />

        <!-- Design 79 §7: "Be om ny kontakt", a 40 dp peach disc in its 48 dp target, while the kid can ask (canAsk). -->
        <ImageButton
            android:id="@+id/phone_book_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/bg_phone_book_plus"
            android:contentDescription="@string/contact_request_open"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_day_add"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Design 106 §3.5 (B2): "Kontakter | Siste" - P9's control, two RadioButtons in a RadioGroup (TalkBack: "Kontakter,
         valgt, 1 av 2"), 44 dp, on the page's tile; shown only while the kid can ask and the form is closed. Neither
         button saves its state: the activity alone holds the tab (a visit always starts on Kontakter). -->
    <RadioGroup
        android:id="@+id/phone_book_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_phone_book_tabs"
        android:contentDescription="@string/phone_book_tabs"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <RadioButton
            android:id="@+id/phone_book_tab_contacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_phone_book_tab"
            android:button="@null"
            android:checked="true"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:hyphenationFrequency="normal"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:saveEnabled="false"
            android:text="@string/phone_book_tab_contacts"
            android:textColor="@color/kid_page_tab_text"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/phone_book_tab_recent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_phone_book_tab"
            android:button="@null"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:hyphenationFrequency="normal"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:saveEnabled="false"
            android:text="@string/phone_book_tab_recent"
            android:textColor="@color/kid_page_tab_text"
            android:textSize="16sp" />
    </RadioGroup>

    <!-- Design 79 §4: the search pill from 8 contacts, under the header, not scrolling (Kontakter only, design 106). -->
    <include
        android:id="@+id/phone_book_search"
        layout="@layout/view_kid_search" />

    <TextView
        android:id="@+id/phone_book_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/kid_page_ink_dim"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_book_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Design 106 §3.6: Siste, one flat list of day headings and call rows, in the contacts list's place. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_book_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- "Fant ingenting", and "Be om å legge til «…»" while the kid can ask. -->
    <include
        android:id="@+id/phone_book_empty"
        layout="@layout/view_kid_search_empty" />

    <include
        android:id="@+id/phone_book_request_form"
        layout="@layout/view_contact_request_form" />
</LinearLayout>
