<?xml version="1.0" encoding="utf-8"?>
<!-- A contact on Home as a round avatar (photo or initial) with its two pills (design 106, A5): the rust missed-call
     pill at the top end, the teal unread-messages pill at the bottom end; 76 or 64 dp - KidAvatars sizes it.
     Depth is the avatar's own elevation with an oval outline (PressFeedback.depth: 2 dp, 4 dp on Home), so the
     frame and this item keep clipChildren=false for the shadow. contact_ring is Home's white 3 dp ring
     (mockup A) over the photo's or the disc's edge, so a photo on a busy wallpaper has an edge; it stays gone
     in the phone book and for an emergency contact, whose red ring is drawn by KidAvatars.bindContact
     (KidAvatars.bindHomeRing); on a light wallpaper it grows 1 dp past the avatar for a dark hairline, hence the
     avatar's clipChildren=false. It is a child of the avatar, so the press scale and shade cover it too; both
     badges are lifted to the avatar's elevation in PressFeedback.contact and sit after it, so they draw above. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/contact_frame"
        android:layout_width="88dp"
        android:layout_height="82dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/contact_avatar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/contact_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_kid_circle"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/contact_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="30sp" />

            <View
                android:id="@+id/contact_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_kid_contact_ring"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Design 106 §2.2 (A5): the teal pill with the unread messages, where the green call badge was (bottom end,
             its end edge 4 dp past the avatar's, within the frame); it grows inward over the avatar. -->
        <TextView
            android:id="@+id/contact_unread_badge"
            style="@style/KidMessageBadge"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:drawablePadding="3dp"
            android:importantForAccessibility="no" />

        <!-- The rust pill with the missed calls (phone and Element X), at the top end. -->
        <TextView
            android:id="@+id/contact_badge"
            style="@style/KidBadge"
            android:layout_gravity="top|end"
            android:drawablePadding="3dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- A name is never cut between letters ("Mamm/a" at 2.0, N7): WholeWordTextView. Its 4 dp sides keep the text
         inside the cell (Home sets maxWidth to the cell), so two neighbours' names are at least 8 dp apart and never
         read as one word (six-inch F3: "Bestemor" / "Kristoffer" at font 1.3). -->
    <com.kidslauncher.mdm.ui.WholeWordTextView
        android:id="@+id/contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:maxWidth="104dp"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/kid_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
