<?xml version="1.0" encoding="utf-8"?>
<!-- The emergency menu (design 73, mockup variant A): "Ring nødnummer", the first real emergency number as a large
     red row, the parent's other numbers as rows (item_emergency_row.xml), Avbryt. One tap on a row calls - the sheet
     is the confirm. Vibb night in both system modes, like the contact sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kid_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_kid_sheet_handle" />

    <TextView
        android:id="@+id/emergency_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/nunito_extrabold"
        android:text="@string/emergency_menu_title"
        android:textColor="@color/kid_core"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/emergency_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/emergency_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/calls_cancel"
        android:textColor="@color/kid_accent"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
