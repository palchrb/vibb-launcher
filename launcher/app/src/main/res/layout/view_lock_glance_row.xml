<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the lock's glance page (design 25 §1.2, mockup LockGlance.dc.html A and B): a button on
     #1B1B28 with 16 dp corners, at least 56 dp, padding 8/12 dp (QA Low 4) - a 36 dp icon (the app's,
     as Home draws it, or the contact's avatar with a red phone badge), the title (15 sp, one line), the
     subtitle (13 sp, one line; two on a screen 720 dp tall or more - @integer/glance_row_text_lines,
     six-inch F4) and the time (12 sp) at the top right. One TalkBack node (the panel sets
     its description and click label); every view here is accessibility-data-sensitive. A tap only leads
     to the keypad: nothing opens before the code. The round parts have fixed equal sizes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glance_row"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clipChildren="false"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/glance_row_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_kid_circle"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/glance_row_initial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/glance_row_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-3dp"
            android:layout_marginBottom="-3dp"
            android:background="@drawable/bg_glance_missed_badge"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_kid_phone"
            android:tint="@color/kid_ink"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <!-- The name line (2026-10-25, qa-launcher-glance-b-code Q-7): the name and its suffix ("· Pappa", "· 3 nye").
             The line wraps its content, so the name is as wide as it is until the line is full; then only the name
             (weight 1) gives way and is cut - the suffix stays whole. -->
        <LinearLayout
            android:id="@+id/glance_row_name_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/glance_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:textColor="@color/kid_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/glance_row_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:textColor="@color/kid_ink"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/glance_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="@integer/glance_row_text_lines"
            android:textColor="@color/kid_core_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/glance_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/nunito_bold"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/kid_core_dim"
        android:textSize="12sp" />

</LinearLayout>
