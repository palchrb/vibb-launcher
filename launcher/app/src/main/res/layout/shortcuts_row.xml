<?xml version="1.0" encoding="utf-8"?>
<!-- Snarveier (design 99 §3, revision 3): the panel - four round buttons in one row, no names (the user,
     2026-11-15: "Må vi ha navn under logoen? Det har ikke ios"). The same view folded and unfolded. 40 dp discs in
     the content's 48 dp height and the folded 45 dp cells at 320 dp. Four quarter cells; a cell is the whole tap
     target, its content description the name and state. Built by shortcuts/ShortcutsNotification.kt as RemoteViews:
     only FrameLayout, LinearLayout and ImageView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/shortcut_cell_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/shortcut_disc_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/shortcut_disc_off" />

        <ImageView
            android:id="@+id/shortcut_glyph_0"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/shortcut_cell_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/shortcut_disc_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/shortcut_disc_off" />

        <ImageView
            android:id="@+id/shortcut_glyph_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/shortcut_cell_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/shortcut_disc_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/shortcut_disc_off" />

        <ImageView
            android:id="@+id/shortcut_glyph_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/shortcut_cell_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/shortcut_disc_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/shortcut_disc_off" />

        <ImageView
            android:id="@+id/shortcut_glyph_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
