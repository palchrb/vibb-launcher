<?xml version="1.0" encoding="utf-8"?>
<!-- lock.PinLockActivity's ring screen for a VoIP call (design 17, QA #12): shown over the keypad
     while an allowed app's call rings and the phone is LOCKED - the app's icon and name (never the
     caller: the notification doesn't say who it is), Decline and Answer as on our call screen.
     Answer opens the app's own ring screen; nothing else leads anywhere. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voip_ring_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="28dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/voip_ring_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:alpha="0.8"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:textColor="@color/kid_ink"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/voip_ring_icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="32dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/voip_ring_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/kid_ink"
        android:textSize="30sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/voip_ring_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:text="@string/voip_ring_failed"
        android:textColor="@color/kid_ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/voip_ring_decline"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_call_red"
                android:clickable="true"
                android:contentDescription="@string/calls_decline"
                android:focusable="true">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:rotation="135"
                    android:src="@drawable/ic_kid_phone" />
            </FrameLayout>

            <TextView
                style="@style/KidCallLabel"
                android:text="@string/calls_decline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/voip_ring_answer"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_call_green"
                android:clickable="true"
                android:contentDescription="@string/calls_answer"
                android:focusable="true">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_kid_phone" />
            </FrameLayout>

            <TextView
                style="@style/KidCallLabel"
                android:text="@string/calls_answer" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
