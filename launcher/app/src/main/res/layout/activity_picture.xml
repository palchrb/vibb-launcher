<?xml version="1.0" encoding="utf-8"?>
<!-- A received picture (design 77 §6.7): the shared header, the picture fit to the screen, and "Lagre" (the peach pill)
     and "Del" (tonal) under it. The picture is the main process's own JPEG, never the raw MMS part (D8). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp">

    <include
        android:id="@+id/picture_header"
        layout="@layout/include_kid_header" />

    <ImageView
        android:id="@+id/picture_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="@string/picture_title"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/picture_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_save"
            android:fontFamily="@font/nunito_extrabold"
            android:minHeight="48dp"
            android:text="@string/picture_save"
            android:textAllCaps="false"
            android:textColor="@color/kid_ground"
            android:textSize="16sp" />

        <Button
            android:id="@+id/picture_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_messages_button"
            android:fontFamily="@font/nunito_extrabold"
            android:minHeight="48dp"
            android:text="@string/picture_share"
            android:textAllCaps="false"
            android:textColor="@color/kid_core"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
