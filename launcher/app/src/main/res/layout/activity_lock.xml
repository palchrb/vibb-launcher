<?xml version="1.0" encoding="utf-8"?>
<!-- The time-rule lock (design 06-time-rules.md; design 34 P6's one calm card), since launcher round L6 in the lock
     glance's look so the two screens read as one design: the glance's clock face (lock.LockClockFace - the clock, the
     date and the next alarm, with the phone's clock profile placed where the glance's stands), the glance's rule card
     (view_lock_rule_card.xml - the kind's glyph, the rule's name, "Til 14:30", and here what still works), one card of
     rows - the phone book when calls are allowed and the usable apps (LockActivity, item_lock_row.xml) - and at the
     bottom "Emergency call" as the glance's red text button. No code entry (2026-10-26: PWA only). Nothing saturated
     and full-width. The attributes the glance has are the glance's (TimeLockModelTest compares them).
     Emergency call sits outside the scrolling part, under it (screen-size fix S1, 2026-11-14): with 3-button navigation
     on a 320 dp phone the content was taller than the room, and the button at the end of the scroll lay under the bar.
     Now the content scrolls above it, fading at an edge with more as the glance's list does, and the button is always
     whole above the navigation bar (KidInsets on the root). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="32dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/lock_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <TextClock
                android:id="@+id/lock_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/kid_ink"
                android:textSize="56sp" />

            <!-- The glance's date: its pattern is the face's (the long date, or the profile's short one). -->
            <TextClock
                android:id="@+id/lock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/kid_core_dim"
                android:textSize="14sp" />

            <!-- The next alarm (design 42 §1.3, the face's bindAlarm): since the calmer glance (2026-11-04) only the
                 evening's wake-up alarm, the alarm glyph and "07:00" (TalkBack "Vekkerklokke 07:00"); no tap. -->
            <TextView
                android:id="@+id/lock_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center_horizontal"
                android:textColor="@color/kid_core_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The glance's rule card, with line 3 (what still works); LockActivity shows it on every render. -->
            <include
                android:id="@+id/lock_rule_card"
                layout="@layout/view_lock_rule_card" />

            <!-- One card: a row per thing that still works (LockActivity fills it; gone when empty), 14 dp under the rule
                 card as the glance's rows. -->
            <LinearLayout
                android:id="@+id/lock_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_lock_card"
                android:clipToOutline="true"
                android:divider="@drawable/bg_lock_row_divider"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone" />

            <!-- The rest of the scrolling part: at least 16 dp above Emergency call. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Always there, whatever the rule, the call state or the lock-screen type (QA step 4 #1): the glance's
         bottom row's "Nødsamtale", >= 48 dp, 8 dp under the content as there (no flashlight here). -->
    <TextView
        android:id="@+id/lock_emergency_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/pin_lock_emergency"
        android:textColor="@color/kid_emergency_text"
        android:textSize="15sp" />
</LinearLayout>
