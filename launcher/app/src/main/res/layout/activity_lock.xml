<?xml version="1.0" encoding="utf-8"?>
<!-- The time-rule lock (design 06-time-rules.md; design 34 P6's one calm card), since launcher round L6 in the lock
     glance's look so the two screens read as one design: the glance's clock face (lock.LockClockFace - the clock, the
     date and the next alarm, with the phone's clock profile placed where the glance's stands), the glance's rule card
     (view_lock_rule_card.xml - the kind's glyph, the rule's name, "Til 14:30", and here what still works), one card of
     rows - the phone book when calls are allowed and the usable apps (LockActivity, item_lock_row.xml) - and at the
     bottom "Emergency call" as the glance's red text button. No code entry (2026-10-26: PWA only). Nothing saturated
     and full-width. The attributes the glance has are the glance's (TimeLockModelTest compares them).
     Emergency call sits outside the scrolling part, under it (screen-size fix S1, 2026-11-14): with 3-button navigation
     on a 320 dp phone the content was taller than the room, and the button at the end of the scroll lay under the bar.
     Now the content scrolls above it, fading at an edge with more as the glance's list does, and the button is always
     whole above the navigation bar (KidInsets on the root). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="32dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/lock_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <!-- Design 98 §4.3 (concept C): a dim "···" top right, 8 dp under the status bar, clear of the clock and the
                 card (its height is given back below, so nothing moves). A tap opens the sheet with Flymodus and
                 Foreldrekode; never a swipe. Gone with no row to show. -->
            <TextView
                android:id="@+id/lock_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginBottom="-48dp"
                android:alpha="0.4"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/lock_more"
                android:focusable="true"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:text="@string/lock_more_glyph"
                android:textColor="@color/kid_core"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/lock_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/kid_ink"
                android:textSize="56sp" />

            <!-- The glance's date: its pattern is the face's (the long date, or the profile's short one). -->
            <TextClock
                android:id="@+id/lock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/kid_core_dim"
                android:textSize="14sp" />

            <!-- The next alarm (design 42 §1.3, the face's bindAlarm): since the calmer glance (2026-11-04) only the
                 evening's wake-up alarm, the alarm glyph and "07:00" (TalkBack "Vekkerklokke 07:00"); no tap. -->
            <TextView
                android:id="@+id/lock_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center_horizontal"
                android:textColor="@color/kid_core_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The glance's rule card, with line 3 (what still works); LockActivity shows it on every render. -->
            <include
                android:id="@+id/lock_rule_card"
                layout="@layout/view_lock_rule_card" />

            <!-- Design 100 §8.3 (the phone mockup): the ask block, directly under the rule card and above the rows' card,
                 14 dp under it, no card ground of its own - the used-up budget's screen only (`lockAsk`). The note
                 line (the parent's answer, or time given), then the pill: "Be om mer tid" in the accent, the open
                 request's note in a dim pill (text, not clickable), or "Spør igjen" with an accent ring; or the cap's
                 line. Lines wrap, never cut; the changes are read out (polite live regions). Gone otherwise. -->
            <LinearLayout
                android:id="@+id/lock_ask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lock_ask_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/nunito_bold"
                    android:gravity="center_horizontal"
                    android:textColor="@color/kid_core"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lock_ask_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lock_ask_capped"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/nunito_bold"
                    android:gravity="center_horizontal"
                    android:text="@string/lock_ask_capped"
                    android:textColor="@color/kid_core_dim"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- One card: a row per thing that still works (LockActivity fills it; gone when empty), 14 dp under the rule
                 card as the glance's rows. -->
            <LinearLayout
                android:id="@+id/lock_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_lock_card"
                android:clipToOutline="true"
                android:divider="@drawable/bg_lock_row_divider"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone" />

            <!-- The rest of the scrolling part: at least 16 dp above Emergency call. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Always there, whatever the rule, the call state or the lock-screen type (QA step 4 #1): the glance's
         bottom row's "Nødsamtale", >= 48 dp, 8 dp under the content as there (no flashlight here). -->
    <TextView
        android:id="@+id/lock_emergency_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/pin_lock_emergency"
        android:textColor="@color/kid_emergency_text"
        android:textSize="15sp" />
</LinearLayout>
