<?xml version="1.0" encoding="utf-8"?>
<!-- ui.kidsettings.KidSoundPickerActivity, opened by Kid Settings' "Ringetone" / "Meldingslyd" (mockup "Velg
     ringetone"): the shared header with the row's name, the caption, the phone's built-in sounds as one radio group in
     a card (item_kid_sound, hairlines between), the closing line. Our own list - never the system picker. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kid_sound_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_page_ground"
    android:fillViewport="true"
    tools:context=".ui.kidsettings.KidSoundPickerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/kid_sound_header"
            layout="@layout/include_kid_header" />

        <TextView
            android:id="@+id/kid_sound_caption"
            style="@style/KidSoundCaption"
            android:layout_marginTop="4dp"
            android:text="@string/kid_sound_caption" />

        <TextView
            android:id="@+id/kid_sound_message"
            style="@style/KidSoundCaption"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/kid_sound_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kid_page_card"
            android:divider="@drawable/bg_lock_row_divider"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:showDividers="middle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/kid_sound_footer"
            style="@style/KidSoundCaption"
            android:layout_marginTop="12dp"
            android:text="@string/kid_sound_footer" />
    </LinearLayout>
</ScrollView>
