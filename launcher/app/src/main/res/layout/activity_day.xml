<?xml version="1.0" encoding="utf-8"?>
<!-- Dagen (design 69 §2.1, mockup dagen.html §1): the shared header (the weekday over the date, "← I dag" / "I dag →"
     off today), a reminder's row while one is up (§2.1 "A reminder in Dagen", step 2), and the endless day pager - one
     day per swipe, a 10 dp peek of the next days. The "+" for the kid's own event (step 3) sits over the pager. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp">

    <include
        android:id="@+id/day_header"
        layout="@layout/include_kid_header" />

    <TextView
        android:id="@+id/day_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_day_event_now"
        android:fontFamily="@font/nunito_extrabold"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/kid_ink"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="-16dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/day_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/day_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_day_add"
            android:contentDescription="@string/day_add"
            android:elevation="4dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_day_add"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
