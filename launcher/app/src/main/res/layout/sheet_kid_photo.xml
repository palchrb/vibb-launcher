<?xml version="1.0" encoding="utf-8"?>
<!-- "Bilde av Mamma" (design 79 §5.2): the kid's own picture of a contact, or of a contact request - Velg bilde, Ta bilde
     (only with a camera the parent allows), Fjern bildet ditt (only while the kid's picture is set), the line that it
     stays on this phone, Avbryt. The contact sheet's night (KidSheetDialog, bg_kid_sheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kid_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:background="@drawable/bg_kid_sheet_handle" />

    <TextView
        android:id="@+id/kid_photo_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center_horizontal"
        android:textColor="@color/kid_core"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/kid_photo_sheet_pick"
        style="@style/KidPhotoSheetRow"
        android:layout_marginTop="16dp"
        android:text="@string/kid_photo_pick" />

    <TextView
        android:id="@+id/kid_photo_sheet_take"
        style="@style/KidPhotoSheetRow"
        android:text="@string/kid_photo_take" />

    <TextView
        android:id="@+id/kid_photo_sheet_remove"
        style="@style/KidPhotoSheetRow"
        android:text="@string/kid_photo_remove" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/nunito_semibold"
        android:gravity="center_horizontal"
        android:text="@string/kid_photo_local_note"
        android:textColor="@color/kid_core_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/kid_photo_sheet_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:minWidth="96dp"
        android:minHeight="48dp"
        android:text="@string/contact_request_cancel"
        android:textColor="@color/kid_core_dim"
        android:textSize="16sp" />
</LinearLayout>
