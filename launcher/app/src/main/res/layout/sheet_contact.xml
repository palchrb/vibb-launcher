<?xml version="1.0" encoding="utf-8"?>
<!-- The contact sheet (mockup ContactCard.dc.html): photo with a ring in the contact's colour,
     missed-call badge, name, missed-call text, Call and Message, which app Message opens, Close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kid_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:background="@drawable/bg_kid_sheet_handle" />

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/sheet_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_kid_circle"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/sheet_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="52sp" />

        <ImageView
            android:id="@+id/sheet_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sheet_badge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_kid_badge_sheet"
            android:drawablePadding="3dp"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/kid_ink"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_kid_missed_call" />
    </FrameLayout>

    <TextView
        android:id="@+id/sheet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:textColor="@color/kid_sheet_ink"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/sheet_missed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/kid_missed_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheet_call"
            style="@style/KidSheetButton"
            android:backgroundTint="@color/kid_call_button"
            android:text="@string/calls_call"
            app:drawableTopCompat="@drawable/ic_kid_phone" />

        <TextView
            android:id="@+id/sheet_message"
            style="@style/KidSheetButton"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/kid_message_button"
            android:text="@string/calls_message"
            app:drawableTopCompat="@drawable/ic_kid_message" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_message_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/kid_sheet_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheet_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/kid_close"
        android:textColor="@color/kid_sheet_muted"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
