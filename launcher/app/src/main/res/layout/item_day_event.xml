<?xml version="1.0" encoding="utf-8"?>
<!-- A Dagen row (design 69 §2.1, mockup dagen.html §1): the start in peach over the end (dim), the title (15 sp, two
     lines at most) and the second line (13 sp dim, two lines at most) - the location, else the description's first
     sentence; a small "›" at the right edge only when something was cut. One TalkBack node: the row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_event"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_day_event"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- The time column: 56 dp, widened per page to its widest time (DayListAdapter, timeColumnPx) - a 12-hour time
         or a larger font never wraps; an all-day row is "Hele" over "dagen" (mockup §1). -->
    <LinearLayout
        android:id="@+id/day_event_time"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/day_event_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:maxLines="1"
            android:textColor="@color/kid_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/day_event_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="1"
            android:textColor="@color/kid_core_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/day_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extrabold"
            android:maxLines="2"
            android:textColor="@color/kid_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/day_event_second"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_semibold"
            android:maxLines="2"
            android:textColor="@color/kid_core_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/day_event_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/nunito_bold"
        android:importantForAccessibility="no"
        android:text="@string/day_more"
        android:textColor="@color/kid_core_dim"
        android:textSize="20sp"
        android:visibility="invisible" />
</LinearLayout>
