<?xml version="1.0" encoding="utf-8"?>
<!-- A conversation in Meldinger (design 77 §6.7), and a contact in "Ny melding": the avatar (KidAvatars), the name
     (800), the last line (600, one line; gone for a contact), and at the right the time over the unread dot. A night
     tile as Dagen's rows. One TalkBack node: the row (its description says it all). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_day_event"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/messages_row_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_kid_circle"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/messages_row_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="20sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messages_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extrabold"
            android:maxLines="1"
            android:textColor="@color/kid_page_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/messages_row_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_semibold"
            android:maxLines="1"
            android:textColor="@color/kid_page_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messages_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="1"
            android:textColor="@color/kid_page_dim"
            android:textSize="12sp" />

        <View
            android:id="@+id/messages_row_unread"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_messages_unread"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
