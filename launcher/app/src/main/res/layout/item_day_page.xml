<?xml version="1.0" encoding="utf-8"?>
<!-- One day of Dagen's pager: its rows as a list (design 69 §2.1). The 3 dp sides with the pager's 13 dp padding make
     the page's 16 dp and a 10 dp peek of the neighbours' cards (DayActivity.PAGER_PAD_DP). The bottom padding is set
     by DayPagerAdapter.pageBottom (screen-size fix S9): a little air, the "+"'s strip (clipped, so no card is drawn under
     the "+"), or the floating "+"'s old 96 dp where the page is too short for the strip. -->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingBottom="12dp" />
