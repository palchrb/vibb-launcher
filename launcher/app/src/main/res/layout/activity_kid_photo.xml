<?xml version="1.0" encoding="utf-8"?>
<!-- The kid's picture of a contact (design 79 §5.2-§5.3): night, not on the wallpaper. The shared header ("Bilde av
     Mamma"), the hint, the square framing (PhotoCropView) and "Bruk bildet" / "Avbryt". It opens the picker or the camera
     at once (KidPhotoActivity); while the picture is read it says so. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <include
        android:id="@+id/kid_photo_header"
        layout="@layout/include_kid_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kid_photo_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/kid_photo_frame_hint"
                android:textColor="@color/kid_core_dim"
                android:textSize="15sp" />

            <com.kidslauncher.mdm.calls.PhotoCropView
                android:id="@+id/kid_photo_crop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <Button
                android:id="@+id/kid_photo_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_contact_request_send"
                android:enabled="false"
                android:fontFamily="@font/nunito_extrabold"
                android:minHeight="48dp"
                android:text="@string/kid_photo_use"
                android:textAllCaps="false"
                android:textColor="@color/kid_ground"
                android:textSize="16sp" />

            <Button
                android:id="@+id/kid_photo_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_messages_button"
                android:fontFamily="@font/nunito_extrabold"
                android:minHeight="48dp"
                android:text="@string/contact_request_cancel"
                android:textAllCaps="false"
                android:textColor="@color/kid_core"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
