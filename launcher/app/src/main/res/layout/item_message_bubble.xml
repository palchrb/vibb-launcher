<?xml version="1.0" encoding="utf-8"?>
<!-- One message in a thread (design 77 §6.7): the bubble - the tile surface for a received one, the peach tint for the
     kid's own, on its side (ThreadAdapter sets the gravity and the background) - with "Ukjent avsender" over a message
     the callback window let in, its pictures and the text; under it, on its side, one small line: the clock time under
     the last bubble of a run, the delivery state under the kid's own ("Ikke sendt - trykk for å prøve igjen"), or both
     ("Levert · 10:47"). The text is never selectable and never linked: nothing in a bubble opens another app. TalkBack
     hears a message as its bubble, the time in its description; the line is a node only for its delivery state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Design 81 D6: the bubble and, on its bottom edge at the corner facing the middle, the reactions' chip (the
         bubble gets a bottom margin then, so the chip never covers the next bubble or the line under this one). -->
    <FrameLayout
        android:id="@+id/bubble_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <!-- A group's message (D12): who in it wrote this one. -->
            <TextView
                android:id="@+id/bubble_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/kid_message_in_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bubble_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:importantForAccessibility="no"
                android:text="@string/messages_unknown"
                android:textColor="@color/kid_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/bubble_parts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bubble_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:importantForAccessibility="no"
                android:textColor="@color/kid_ink"
                android:textIsSelectable="false"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bubble_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_message_reaction_chip"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Never wider than the row: a long line (a failed send's, a large font) wraps, towards the bubble's side. -->
    <TextView
        android:id="@+id/bubble_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/nunito_bold"
        android:minHeight="24dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/kid_core_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
