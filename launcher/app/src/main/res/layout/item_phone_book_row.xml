<?xml version="1.0" encoding="utf-8"?>
<!-- A phone book row (design 79 §3.4, designed at the Jelly Star's 288 dp of content): a solid night tile (bg_day_event,
     #1B1B28, 18 dp) so it reads on any wallpaper; the 44 dp avatar with its badge; the name (never cut between letters,
     WholeWordTextView) and a second line only when there is something to say; Ring and Melding as two 38 dp tonal discs
     in touching 48 dp targets at the tile's end (its end padding 0). From font scale 1.3 (rowLayout) the buttons move
     to row_stack, on a line of their own from the text's start. A tap anywhere else opens the contact card; the row is
     TalkBack's one node, the buttons its custom actions (PhoneBookAdapter). No long-press. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_day_event"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/row_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/contact_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clipChildren="false"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:id="@+id/contact_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_kid_circle"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/contact_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="18sp" />

            <!-- The badge at the avatar's top end, lifted, reaching past the avatar's edge into the gap (moved, not laid
                 out there: a wider badge never pushes itself back over the avatar; its parents don't clip). -->
            <TextView
                android:id="@+id/contact_badge"
                style="@style/KidBadge"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:translationX="10dp"
                android:translationY="-6dp"
                android:drawablePadding="2dp"
                android:importantForAccessibility="no"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/row_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <com.kidslauncher.mdm.ui.WholeWordTextView
                android:id="@+id/row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="2"
                android:textColor="@color/kid_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/row_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="2"
                android:textColor="@color/kid_core_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/row_call"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clipChildren="false"
                android:focusable="true"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/row_call_disc"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_phone_book_button"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_kid_phone"
                    android:tint="@color/kid_call_glyph" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/row_message"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clipChildren="false"
                android:focusable="true"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/row_message_disc"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_phone_book_button"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_kid_message"
                    android:tint="@color/kid_accent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Large text: the buttons on a line of their own, from the text's start (the disc's edge under the text's). -->
    <LinearLayout
        android:id="@+id/row_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
