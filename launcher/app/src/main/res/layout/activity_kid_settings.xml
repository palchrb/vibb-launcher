<?xml version="1.0" encoding="utf-8"?>
<!-- The kid's Settings (design 08-ui-polish.md §2, mockup KidSettings.dc.html): the wallpaper as
     ground, back button + title, the parent's wallpapers to pick from, then "Connection and
     screen" with the switches the parent turned on. Nothing here changes a rule. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kid_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_ground"
    android:fillViewport="true"
    tools:context=".ui.kidsettings.KidSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/kid_settings_header"
            layout="@layout/include_kid_header" />

        <LinearLayout
            android:id="@+id/kid_settings_wallpaper_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kid_settings_wallpaper_heading"
                style="@style/KidSettingsHeading"
                android:text="@string/kid_settings_background" />

            <LinearLayout
                android:id="@+id/kid_settings_wallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/kid_settings_wallpaper_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/kid_settings_background_caption"
                android:textColor="@color/kid_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The kid's look (design 78 §7): Mørk or Lys for the kid's own pages, as the sound row's segmented control,
             with a preview drawn in the chosen look's real tokens (PageLook.wrap) and a caption that says what it
             covers. Shown in every build since step 2. -->
        <LinearLayout
            android:id="@+id/kid_settings_look_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kid_settings_look_heading"
                style="@style/KidSettingsHeading"
                android:text="@string/kid_settings_look" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_kid_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <RadioGroup
                    android:id="@+id/kid_settings_look_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kid_segment_track"
                    android:contentDescription="@string/kid_settings_look"
                    android:orientation="horizontal"
                    android:padding="3dp">

                <RadioButton
                    android:id="@+id/kid_settings_look_dark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:hyphenationFrequency="normal"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/kid_settings_look_dark"
                    android:textColor="@color/kid_ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/kid_settings_look_light"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:hyphenationFrequency="normal"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/kid_settings_look_light"
                    android:textColor="@color/kid_ink"
                    android:textSize="14sp" />
                </RadioGroup>

                <!-- The preview (view_look_preview), inflated by the activity in the chosen look. -->
                <FrameLayout
                    android:id="@+id/kid_settings_look_preview"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="noHideDescendants" />
            </LinearLayout>

            <TextView
                android:id="@+id/kid_settings_look_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/kid_settings_look_caption"
                android:textColor="@color/kid_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/kid_settings_controls_heading"
            style="@style/KidSettingsHeading"
            android:layout_marginTop="14dp"
            android:text="@string/kid_settings_connection" />

        <TextView
            android:id="@+id/kid_settings_controls_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/kid_ink"
            android:alpha="0.85"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/kid_settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_kid_card"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/kid_settings_wifi_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/kid_settings_wifi_switch"
                    style="@style/KidSwitchRow"
                    android:text="@string/quick_controls_wifi" />

                <TextView
                    android:id="@+id/kid_settings_wifi_manage"
                    style="@style/KidManageLink"
                    android:text="@string/quick_controls_manage_networks" />

                <View style="@style/KidDivider" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kid_settings_bluetooth_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/kid_settings_bluetooth_switch"
                    style="@style/KidSwitchRow"
                    android:text="@string/quick_controls_bluetooth" />

                <TextView
                    android:id="@+id/kid_settings_bluetooth_manage"
                    style="@style/KidManageLink"
                    android:text="@string/quick_controls_manage_devices" />

                <View style="@style/KidDivider" />
            </LinearLayout>

            <!-- Sound (design 18): two choices, Sound = ringer Normal and "Silent (vibrate)" =
                 ringer Vibrate - never Android's Silent, which is Do Not Disturb. Read-only with a
                 note while DND is on. Design 34 P9: one even segmented control - a white 8 % track
                 (bg_kid_segment_track), two equal halves (weight 1, no gap) >= 48 dp tall whose
                 labels wrap and grow the control with the font scale (no maxLines, no ellipsize);
                 the chosen half is drawn in code (the accent with night text, the other the
                 wallpaper's ink - segmentColours in ui/kidsettings/SoundSegments.kt). Still two RadioButtons in a
                 horizontal RadioGroup, so TalkBack reads radio buttons in a group of two with the
                 selected state (QA L7); the visible label is the group's name, read once. -->
            <LinearLayout
                android:id="@+id/kid_settings_sound_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/kid_settings_sound_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:importantForAccessibility="no"
                        android:text="@string/kid_settings_sound"
                        android:textColor="@color/kid_ink"
                        android:textSize="16sp" />

                    <RadioGroup
                        android:id="@+id/kid_settings_sound_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_kid_segment_track"
                        android:contentDescription="@string/kid_settings_sound"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <RadioButton
                            android:id="@+id/kid_settings_sound_on"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:button="@null"
                            android:fontFamily="@font/nunito_extrabold"
                            android:gravity="center"
                            android:hyphenationFrequency="normal"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp"
                            android:text="@string/kid_settings_sound_on"
                            android:textColor="@color/kid_ink"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/kid_settings_sound_vibrate"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:button="@null"
                            android:fontFamily="@font/nunito_extrabold"
                            android:gravity="center"
                            android:hyphenationFrequency="normal"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp"
                            android:text="@string/kid_settings_sound_vibrate"
                            android:textColor="@color/kid_ink"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/kid_settings_sound_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/kid_ink"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <View style="@style/KidDivider" />
            </LinearLayout>

            <!-- The kid's ringtone and message sound (PLAN, approved 2026-11-04; ui/kidsettings/SoundPicks.kt): with the
                 sound bit, each row the sound's name and a chevron, opening our own picker (KidSoundPickerActivity -
                 never the system's). Without the "Modify system settings" app-op both at 50 %, not clickable, with the
                 touch row's "can't be changed" line, and no chevron (E9 L7). No vibration rows (SoundPicks.kt says why). The row is one
                 button; TalkBack reads its label and value. -->
            <LinearLayout
                android:id="@+id/kid_settings_picks_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/kid_settings_ringtone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/kid_settings_ringtone_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/kid_settings_ringtone"
                        android:textColor="@color/kid_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/kid_settings_ringtone_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_extrabold"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textColor="@color/kid_ink"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/kid_settings_ringtone_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_kid_chevron" />
                </LinearLayout>

                <View style="@style/KidDivider" />

                <LinearLayout
                    android:id="@+id/kid_settings_message_sound_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/kid_settings_message_sound_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/kid_settings_message_sound"
                        android:textColor="@color/kid_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/kid_settings_message_sound_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_extrabold"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textColor="@color/kid_ink"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/kid_settings_message_sound_chevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_kid_chevron" />
                </LinearLayout>

                <TextView
                    android:id="@+id/kid_settings_picks_read_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/kid_settings_touch_read_only"
                    android:textColor="@color/kid_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View style="@style/KidDivider" />
            </LinearLayout>

            <!-- Touch sounds and vibration (design r9 §4): Android's two switches for taps, while the parent's
                 bit is on. Without the "Modify system settings" app-op both show the phone's state at 50 % with
                 the "can't be changed" line; no vibration switch on a phone without a vibrator. The keyboard's
                 line says its sound and vibration are its own; nothing opens. -->
            <LinearLayout
                android:id="@+id/kid_settings_touch_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/kid_settings_touch_sounds"
                    style="@style/KidSwitchRow"
                    android:text="@string/kid_settings_touch_sounds" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/kid_settings_touch_vibration"
                    style="@style/KidSwitchRow"
                    android:text="@string/kid_settings_touch_vibration" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/kid_settings_touch_read_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/kid_settings_touch_read_only"
                        android:textColor="@color/kid_ink"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/kid_settings_touch_keyboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/kid_settings_touch_keyboard"
                        android:textColor="@color/kid_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <View style="@style/KidDivider" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kid_settings_brightness_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/kid_settings_brightness_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:labelFor="@id/kid_settings_brightness_seekbar"
                    android:text="@string/quick_controls_brightness"
                    android:textColor="@color/kid_ink"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/kid_settings_brightness_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/quick_controls_brightness"
                    android:max="255"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="@color/kid_slider"
                    android:thumbTint="@color/kid_slider" />
            </LinearLayout>
        </LinearLayout>

        <!-- The kid's hidden apps (the user, 2026-11-03): only while the kid has hidden an app with Home's long-press
             "Skjul" that Home would otherwise show (homeApps with EXCLUSIVE - the parent's off-Home apps never). The
             row opens the list in the card (its state for TalkBack in code); a tap on an app shows it on Home again
             at once. The list's rows are item_kid_hidden_app. -->
        <LinearLayout
            android:id="@+id/kid_settings_hidden_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kid_card"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/kid_settings_hidden_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/kid_settings_hidden_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/kid_settings_hidden_apps"
                    android:textColor="@color/kid_ink"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/kid_settings_hidden_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_kid_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kid_settings_hidden_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Design 64 step 2 (the user's decision 6): one calm line, no control, while the phone
             shares its location (sharesLocation) - the wallpaper caption's look. -->
        <TextView
            android:id="@+id/kid_settings_location_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0.7"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/kid_settings_location_shared"
            android:textColor="@color/kid_ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
