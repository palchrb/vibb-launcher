<?xml version="1.0" encoding="utf-8"?>
<!-- One item in ShortcutsPickerActivity (design 99 §4.2): a check box with the item's glyph and full name, its sub-line
     when it shows only some days, and on a chosen row "Flytt opp" / "Flytt ned" (48 dp, with descriptions). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/shortcut_pick_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:buttonTint="@color/kid_page_accent"
            android:drawablePadding="12dp"
            android:drawableTint="@color/kid_page_ink"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="@color/kid_page_ink"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/shortcut_pick_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:rotation="-90"
            android:scaleType="center"
            android:src="@drawable/ic_kid_chevron"
            android:tint="@color/kid_page_ink" />

        <ImageButton
            android:id="@+id/shortcut_pick_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:rotation="90"
            android:scaleType="center"
            android:src="@drawable/ic_kid_chevron"
            android:tint="@color/kid_page_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/shortcut_pick_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.75"
        android:fontFamily="@font/nunito_bold"
        android:paddingStart="48dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/kid_page_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
