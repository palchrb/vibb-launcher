<?xml version="1.0" encoding="utf-8"?>
<!-- The kid-facing screens (design 05-ui-photos-i18n.md, mockup "handy launcher skisse"), in the
     Vibb night palette since the fix round 2026-10-06 (palchrb/vibb pi/art): ground #0C0C14,
     accent #F0A884 (the rings), light #FBE4DC (the core). Functional colours stay: green call and
     answer, red hang-up and emergency. Contrast on the ground (KidPaletteTest): white 19:1, accent
     9.9:1, light 16:1. Use these resources, not literals. -->
<resources>
    <color name="kid_ground">#0C0C14</color>
    <!-- A slightly lifted night, the top of the call screens' gradient and their status bar. -->
    <color name="kid_ground_lift">#1C1A2A</color>
    <color name="kid_accent">#F0A884</color>
    <color name="kid_core">#FBE4DC</color>
    <!-- The Vibb mark's night ground: app icon and Home's launch splash. -->
    <color name="vibb_night">@color/kid_ground</color>
    <color name="kid_ink">#FFFFFF</color>
    <color name="kid_ink_dim">#BFFFFFFF</color>
    <color name="kid_badge">#B4532C</color>
    <color name="kid_call_badge">#2F9E44</color>
    <!-- The Phone book tile (and the time-rule screen's phone book row): a muted call green,
         white 5.5:1, ground 3.6:1 (design 34 P1, QA M3; it was #37B24D, white 2.75:1). -->
    <color name="kid_phone_book">#3A7552</color>
    <color name="kid_back_button">#1FFFFFFF</color>
    <!-- The contact sheet at night (design 34 P3, QA M4): the lifted night, no white surface. Its
         name is kid_core, its hint and Close kid_sheet_muted (= kid_core_dim), Message a tonal
         white with a peach glyph; every pair is in KidPaletteTest. -->
    <color name="kid_sheet">@color/kid_ground_lift</color>
    <!-- Only Home's window banner (activity_home.xml, bg_home_window_lock_again.xml) since design
         34: the sheet's name is kid_core now. -->
    <color name="kid_sheet_ink">#1B1B1F</color>
    <color name="kid_sheet_muted">@color/kid_core_dim</color>
    <color name="kid_sheet_handle">#38FFFFFF</color>
    <color name="kid_sheet_button">#14FFFFFF</color>
    <color name="kid_missed_text">#FF8A8A</color>
    <!-- The call green: Ring, the answer button, Home's call card (white 4.77:1, design 34 QA L1). -->
    <color name="kid_call_button">#29833B</color>
    <!-- The time-rule screen (design 34 P6): the kind's icon sits in a disc of the accent at 14 %,
         the card's rows (kid_ground_lift, as the contact sheet) end in a chevron of the light at 50 %.
         kid_message_button (the old saturated app buttons) is gone with them. -->
    <color name="kid_lock_kind_disc">#24F0A884</color>
    <color name="kid_lock_chevron">#80FBE4DC</color>
    <color name="kid_emergency">#E03131</color>
    <!-- The light neutral disc under a legacy (non-adaptive) icon drawn as itself (design 34 P1). -->
    <color name="kid_icon_fallback">#F1F3F5</color>
    <!-- Home's Settings tile: the slate tone (design 34 P1, IconTones TONE_SLATE; white 5.4:1). -->
    <color name="kid_settings_tile">#606B80</color>
    <!-- Home's flashlight tile (design 41): the indigo tone while dark (IconTones TONE_INDIGO; white
         5.3:1), the filled peach disc with the night glyph while lit (kid_accent / kid_ground, 9.9:1). -->
    <color name="kid_torch_tile">#6065A9</color>
    <color name="kid_switch_on">@color/kid_accent</color>
    <color name="kid_slider">@color/kid_accent</color>
    <color name="kid_divider">#1AFFFFFF</color>
    <!-- Vibb music (design 21 step 4, mockups HomeCard/Lock.dc.html v12): Home's "Spilles nå"
         card, the lock's media tile and its round controls, the light at 78 % for second lines,
         and the lock's plain emergency text. -->
    <color name="kid_music_card">#2A2233</color>
    <color name="kid_music_tile">#1B1B28</color>
    <color name="kid_music_control">#2A2A3A</color>
    <color name="kid_core_dim">#C7FBE4DC</color>
    <color name="kid_emergency_text">#FF8A8A</color>
    <!-- The tonal emergency red's ground (design 34): the 112 avatar (EMERGENCY_AVATAR, which
         KidPaletteTest keeps equal to this pair) and P7's emergency pill. -->
    <color name="kid_emergency_tonal">#3A1E24</color>
</resources>
