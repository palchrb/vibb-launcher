<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The default colour theme - the drawer and the parent Settings - in Vibb night with the
         peach accent (design 34 P5; it was the upstream grey #252827 and #5555ff). Contrast in
         KidPaletteTest: white 19:1, peach 9.9:1 on the ground. -->
    <color name="finnmglasTheme_background_color">@color/kid_ground</color>
    <color name="finnmglasTheme_accent_color">@color/kid_accent</color>
    <color name="finnmglasTheme_text_color">@color/kid_ink</color>

    <color name="darkTheme_background_color">#000</color>
    <color name="darkTheme_accent_color">#444</color>
    <color name="darkTheme_text_color">#fff</color>

    <color name="lightTheme_background_color">#fff</color>
    <color name="lightTheme_accent_color">#9999ff</color>
    <color name="lightTheme_text_color">#000</color>
    <!-- The light parent dialogs' error line (design r10's code dialog; about 5.5:1 on white, ReEnrolTest). -->
    <color name="dialog_error_text">#C92A2A</color>
</resources>

