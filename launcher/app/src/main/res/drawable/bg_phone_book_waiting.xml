<?xml version="1.0" encoding="utf-8"?>
<!-- An open contact request in the phone book (design 79 §3.4): the row's tile with a 1.5 dp peach outline at 45 %; not
     clickable, so no ripple. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kid_page_tile" />
    <stroke android:width="1.5dp" android:color="@color/kid_page_accent_edge" />
    <corners android:radius="18dp" />
</shape>
