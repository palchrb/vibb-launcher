<?xml version="1.0" encoding="utf-8"?>
<!-- Round back button: a 44 dp circle (white 12 %; on a page in Lys black 6 %, design 78) inside a 48 dp
     touch target (QA 08 #13). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="2dp">
    <ripple android:color="@color/kid_page_ripple_strong">
        <item>
            <shape android:shape="oval">
                <solid android:color="@color/kid_page_back" />
            </shape>
        </item>
    </ripple>
</inset>
