<?xml version="1.0" encoding="utf-8"?>
<!-- A page's dialog panel (KidPageAlertDialog, VibbPickerDialog; design 78 §4.4): bg_kid_dialog in the page's lift -
     the lifted night in Mørk, white in Lys. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="?attr/dialogCornerRadius" />
        <solid android:color="@color/kid_page_lift" />
    </shape>
</inset>
