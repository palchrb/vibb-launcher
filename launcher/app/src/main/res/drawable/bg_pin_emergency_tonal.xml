<?xml version="1.0" encoding="utf-8"?>
<!-- "Nødsamtale" pill on the PIN keypad (design 34 P7): tonal, the muted emergency red - #3A1E24 under
     #FF8A8A text and glyph (6.6:1, KidPaletteTest), quiet against the ground (about 1.3:1, QA N4: the
     text and glyph identify it). 24 dp radius, so it is a pill at its 48 dp minimum and rounds off
     when a large font wraps it. The VoIP ring's pill keeps bg_pin_emergency. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kid_emergency_tonal" />
    <corners android:radius="24dp" />
</shape>
