<?xml version="1.0" encoding="utf-8"?>
<!-- Design 106 §3.5: the "Kontakter | Siste" switch's track - the page's tile, fully rounded; in Lys a hairline
     (kid_page_edge), since the white tile is 1.11:1 on the paper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kid_page_tile" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/kid_page_edge" />
</shape>
