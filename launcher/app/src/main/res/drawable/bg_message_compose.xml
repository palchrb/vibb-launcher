<?xml version="1.0" encoding="utf-8"?>
<!-- The compose field: the page's tile as a pill, with a 1 dp hairline in Lys (design 78 §4.1: an input must be
     identifiable on the paper; none at night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kid_page_tile" />
    <stroke android:width="1dp" android:color="@color/kid_page_edge" />
    <corners android:radius="24dp" />
</shape>
