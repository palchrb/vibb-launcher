<?xml version="1.0" encoding="utf-8"?>
<!-- The ongoing Dagen row: the tile with a 1.5 dp inner ring in the page accent - peach in Mørk, the dark peach in
     Lys (design 78) - and "Pågår nå" says it without colour too. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/kid_page_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kid_page_tile" />
            <stroke android:width="1.5dp" android:color="@color/kid_page_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
