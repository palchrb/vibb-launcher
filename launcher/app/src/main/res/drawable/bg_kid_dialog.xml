<?xml version="1.0" encoding="utf-8"?>
<!-- The default AlertDialog's panel at night (KidAlertDialog, qa-34-s5-code M1): AppCompat's
     abc_dialog_material_background with the lifted night instead of white. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="?attr/dialogCornerRadius" />
        <solid android:color="@color/kid_ground_lift" />
    </shape>
</inset>
