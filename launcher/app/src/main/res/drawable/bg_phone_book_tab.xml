<?xml version="1.0" encoding="utf-8"?>
<!-- Design 106 §3.5: one half of the switch. It takes taps over the whole track's height; its fill is drawn 4 dp in
     (the track's padding): the chosen half in the accent fill, the other none. The press is the tile's ripple, clipped
     to the same inset pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/kid_page_ripple">
    <item android:id="@android:id/mask">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/kid_page_tile" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <selector>
            <item android:state_checked="true">
                <inset android:inset="4dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/kid_page_accent_fill" />
                        <corners android:radius="18dp" />
                    </shape>
                </inset>
            </item>
        </selector>
    </item>
</ripple>
