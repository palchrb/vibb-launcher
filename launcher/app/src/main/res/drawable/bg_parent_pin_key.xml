<?xml version="1.0" encoding="utf-8"?>
<!-- A key of the parent PIN's own keypad (design 24b §1.8), on the light dialog. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#0F000000" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#33000000" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#1A000000" /></shape>
    </item>
</selector>
