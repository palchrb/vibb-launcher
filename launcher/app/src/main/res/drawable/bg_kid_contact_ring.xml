<?xml version="1.0" encoding="utf-8"?>
<!-- Home's ring on a contact's avatar (mockup A): 3 dp, white at 95 %, inside the avatar's edge - the layout's default;
     KidAvatars.bindHomeRing draws it in the name pill's colours (dark on a light wallpaper) with its outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="3dp" android:color="#F2FFFFFF" />
</shape>
