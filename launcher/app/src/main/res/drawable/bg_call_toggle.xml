<?xml version="1.0" encoding="utf-8"?>
<!-- Speaker/Mute: white at 16 % when off, white when on (the icon turns navy, InCallActivity). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#40FFFFFF" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#29FFFFFF" /></shape></item>
</selector>
