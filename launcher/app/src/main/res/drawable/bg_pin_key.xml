<?xml version="1.0" encoding="utf-8"?>
<!-- PIN lock key (mockup Lock.dc.html): white at 12 %, darker while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#40FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#1FFFFFFF" /></shape>
    </item>
</selector>
