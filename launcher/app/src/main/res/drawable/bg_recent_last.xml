<?xml version="1.0" encoding="utf-8"?>
<!-- Design 106 §3.6: a Siste row's tile by its place in its day (last) - plain shapes, so a day reads as one card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kid_page_tile" />
    <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
</shape>
