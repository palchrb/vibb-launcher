<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- "Ny avtale"'s date and time pickers on a page in Lys (design 78 §4.4): the framework's light Material
         dialog, so everything the pickers draw that we don't name (their ripples, the keyboard entry's fields, the
         disabled tones) is the light form. A qualified style replaces the whole style and never merges with the one
         in values/, so every item is named again (SplashThemeTest); the values are the same page tokens, which
         resolve to the day here. VibbDatePicker and VibbTimePicker need no twin: they name page tokens only. -->
    <style name="VibbPickerDialog" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@drawable/bg_kid_page_dialog</item>
        <item name="android:colorBackground">@color/kid_page_lift</item>
        <item name="android:colorBackgroundFloating">@color/kid_page_lift</item>
        <item name="android:colorPrimary">@color/kid_page_accent_fill</item>
        <item name="android:colorAccent">@color/kid_page_accent</item>
        <item name="android:colorControlActivated">@color/kid_page_accent_fill</item>
        <item name="android:colorControlNormal">@color/kid_page_ink</item>
        <item name="android:textColor">@color/kid_page_ink</item>
        <item name="android:textColorPrimary">@color/kid_page_ink</item>
        <item name="android:textColorSecondary">@color/kid_page_dim</item>
        <item name="android:textColorPrimaryInverse">@color/kid_on_accent</item>
        <item name="android:textColorSecondaryInverse">@color/kid_on_accent</item>
        <item name="android:datePickerStyle">@style/VibbDatePicker</item>
        <item name="android:timePickerStyle">@style/VibbTimePicker</item>
    </style>

</resources>
