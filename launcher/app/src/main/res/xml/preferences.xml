<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Design 114 §6.3: one row for the setup - "{n} steg igjen" (orange) or "Fullført"; a tap opens the setup flow,
         where the steps are (no step rows here). The summary is set in code. -->
    <Preference
        android:key="settings_setup"
        android:title="@string/settings_setup_title" />

    <Preference
        android:key="@string/settings_apps_hidden_key"
        android:title="@string/settings_apps_hidden" />

    <SwitchPreference
        android:key="@string/settings_display_rotate_screen_key"
        android:defaultValue="true"
        android:title="@string/settings_display_rotate_screen" />

    <Preference
        android:key="settings_meta_licenses"
        android:title="@string/settings_meta_licenses" />

    <Preference
        android:key="settings_meta_version"
        android:title="@string/settings_meta_version" />

    <Preference
        android:key="@string/settings_mdm_server_url_key"
        android:title="@string/settings_mdm_server_url" />

    <!-- Design 76: the certificate check's state; tapping it explains and names the recovery. -->
    <Preference
        android:key="settings_mdm_server_cert"
        android:title="@string/settings_mdm_server_cert" />

    <Preference
        android:key="@string/settings_mdm_tailscale_auth_key_key"
        android:title="@string/settings_mdm_tailscale_auth_key" />

    <Preference
        android:key="settings_mdm_scan_setup_qr"
        android:title="@string/settings_mdm_scan_setup_qr"
        android:summary="@string/settings_mdm_scan_setup_qr_summary" />

    <Preference
        android:key="settings_mdm_enroll_now"
        android:title="@string/settings_mdm_enroll_now" />

    <Preference
        android:key="settings_mdm_sync_now"
        android:title="@string/settings_mdm_sync_now" />

    <!-- Design 108 §6.5: app push (UnifiedPush) diagnostics - each registration's app, its account (on the phone only)
         and its last delivery; shown and summarised in code. -->
    <Preference
        android:key="settings_mdm_unified_push"
        android:selectable="false"
        android:title="@string/settings_up_title"
        app:isPreferenceVisible="false" />

    <Preference
        android:key="settings_play_install_mode"
        android:title="@string/settings_play_install_mode"
        android:summary="@string/settings_play_install_mode_summary" />

    <SwitchPreference
        android:key="@string/settings_mdm_restrictions_paused_key"
        android:defaultValue="false"
        android:title="@string/settings_mdm_restrictions_paused"
        android:summary="@string/settings_mdm_restrictions_paused_summary" />

    <!-- Design 68 §4.2: one row per allowed app and special access it declares (Android's page for it, in a pause),
         filled in code; hidden while empty. Last, so no other row falls under its header. -->
    <PreferenceCategory
        android:key="settings_mdm_app_access"
        android:title="@string/app_access_category"
        app:isPreferenceVisible="false" />

</PreferenceScreen>
