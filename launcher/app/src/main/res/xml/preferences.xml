<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="@string/settings_apps_hidden_key"
        android:title="@string/settings_apps_hidden" />

    <SwitchPreference
        android:key="@string/settings_display_rotate_screen_key"
        android:defaultValue="true"
        android:title="@string/settings_display_rotate_screen" />

    <Preference
        android:key="settings_meta_licenses"
        android:title="@string/settings_meta_licenses" />

    <Preference
        android:key="settings_meta_version"
        android:title="@string/settings_meta_version" />

    <Preference
        android:key="@string/settings_mdm_server_url_key"
        android:title="@string/settings_mdm_server_url" />

    <Preference
        android:key="@string/settings_mdm_tailscale_auth_key_key"
        android:title="@string/settings_mdm_tailscale_auth_key" />

    <Preference
        android:key="settings_mdm_scan_setup_qr"
        android:title="@string/settings_mdm_scan_setup_qr"
        android:summary="@string/settings_mdm_scan_setup_qr_summary" />

    <Preference
        android:key="settings_mdm_enroll_now"
        android:title="@string/settings_mdm_enroll_now" />

    <Preference
        android:key="settings_mdm_sync_now"
        android:title="@string/settings_mdm_sync_now" />

    <!-- Design 19b: the battery-optimisation exemption; the summary is set in code. -->
    <Preference
        android:key="settings_mdm_background_connection"
        android:title="@string/settings_mdm_background_connection" />

    <!-- "Modify system settings" (the touch sounds row, the clock format) without adb; the
         summary is set in code. -->
    <Preference
        android:key="settings_mdm_write_settings"
        android:title="@string/settings_mdm_write_settings" />

    <!-- Android's fingerprint enrolment for the kid (android mode, a phone with a sensor); shown and summarised in
         code. -->
    <Preference
        android:key="settings_mdm_fingerprint"
        android:title="@string/settings_mdm_fingerprint"
        app:isPreferenceVisible="false" />

    <Preference
        android:key="settings_play_install_mode"
        android:title="@string/settings_play_install_mode"
        android:summary="@string/settings_play_install_mode_summary" />

    <SwitchPreference
        android:key="@string/settings_mdm_restrictions_paused_key"
        android:defaultValue="false"
        android:title="@string/settings_mdm_restrictions_paused"
        android:summary="@string/settings_mdm_restrictions_paused_summary" />

</PreferenceScreen>
