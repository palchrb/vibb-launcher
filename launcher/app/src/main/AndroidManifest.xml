<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- In-app "Scan setup QR" flow (SettingsFragmentLauncher, zxing-android-embedded) - Device
         Owner self-grants this the same way as other prompt-free permissions elsewhere in this
         file, so scanning never shows the runtime permission dialog. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-granted silently via DevicePolicyManager.setPermissionGrantState, required to call
         BluetoothAdapter.enable()/disable() from the Quick Controls screen on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Same self-grant pattern, required for BluetoothAdapter.startDiscovery() on Android 12+,
         used by the Quick Controls "manage devices" screen. neverForLocation for the same reason
         as NEARBY_WIFI_DEVICES below - we only need device identity, never physical position -
         and without it Android additionally requires the phone's system-wide Location toggle to
         be on before discovery returns any results at all, independent of this permission grant. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Normal-level, auto-granted at install - required to read/toggle WiFi state from the
         Quick Controls screen. Device Owner exempts us from the API 29+ restriction on WHO can
         toggle WiFi, but these are still required regardless of Device Owner status. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The kid's wallpaper on the system wallpaper (ui/wallpaper/WallpaperApplier, design 08). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- One clock format on the whole phone (design 34 P12, server/ClockFormatSetting): writing
         Settings.System.TIME_12_24 needs the "Modify system settings" app-op, which the device owner
         can't grant - the parent turns it on during a pause from Settings' "Modify system settings"
         row (server/WriteSettingsAccess), or `adb shell appops set me.vibb.launcher WRITE_SETTINGS
         allow` as the shortcut. The touch sounds row needs it too. Without it nothing is written and
         the PWA warns. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Settings' "Fingerprint" row (server/FingerprintEnrol): BiometricManager.canAuthenticate needs it to tell
         "registered" from "not registered" (code QA Q-1). A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Self-granted, required for WifiManager.startScan()/getScanResults() on Android 13+ -
         replaces the old ACCESS_FINE_LOCATION scanning requirement. neverForLocation since the
         Quick Controls "manage networks" screen only needs SSIDs, never physical position. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-granted, for Find My Device's location trail (LocateCommands.kt). Plain
         android.location.LocationManager, never FusedLocationProviderClient - this project has no
         Google Play Services anywhere (GrapheneOS has none). ACCESS_BACKGROUND_LOCATION is needed
         since the read happens from MdmSyncWorker, a background job, not direct foreground user
         action - unconfirmed whether Device Owner can self-grant this one specifically, unlike
         every other permission in this app; see QuickControls/MdmSyncWorker for the diagnostic
         logging around it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- CommandListenerService is the always-on process anchor (handy step 7): every background
         sync and the SSE stream, the only way the server nudges the phone (design 19). Type
         "specialUse" (parental control enforcement): "dataSync" is capped at 6 h a day on
         Android 15+ and may not start from BOOT_COMPLETED there. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- KidVpnService's on-device DNS filter (see CLAUDE.md) - "specialUse" since none of the
         other API 34 foreground-service types fit "local VPN packet filter"; the required
         PROPERTY_SPECIAL_USE_FGS_SUBTYPE declaration is on the <service> element below.
         BIND_VPN_SERVICE itself is a system-enforced permission that goes on the <service>
         element's android:permission attribute (restricting who may bind to it, i.e. only the
         OS) - not something this app requests for its own use, so no <uses-permission> for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Calls (calls/ package, design 02-calls.md): placing calls from the phone book, reading the
         caller's number, contact-independent screening (CallScreeningService only sees numbers
         outside the user's contacts unless READ_CONTACTS is granted), the call log for the
         callback window after an emergency call, and the in-call screen. Device owner self-grants
         the runtime ones (AppEnforcer.applyCallPermissions); the dialer role grants most too.
         WRITE_CALL_LOG only to delete blocked calls older than 30 days (calls.BlockedCallLog). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Dagen (design 69): the calendar provider that ICSx5 and DAVx5 feed, and the kid's own events in their calendar;
         self-granted by the device owner. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Design 19b: Android's "allow to run in the background" dialog (Settings' Background
         connection row) - without it the dialog finishes silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Design 17: the PIN lock's own ring for a VoIP call vibrates (lock.VoipRinger). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LOCKED_BOOT_COMPLETED for calls.BootCallReceiver (direct boot, task 15). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- One exact alarm at the next time-rule boundary (timerules.TimeRuleAlarm, handy step 6).
         Granted at install, unlike SCHEDULE_EXACT_ALARM; Play limits it to alarm apps, which
         doesn't apply to this sideloaded device-owner app. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Design 77 (sms/): Vibb One is the SMS app while SMS is "Styrt av Vibb". The SMS role grants these; the device
         owner fixes them by policy before a role changes hands (§8.3), so a hand-back never kills the process.
         READ_PHONE_NUMBERS: the SIMs' own numbers (D12). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Vibb music (design 21 §2): only an app signed like this launcher may bind the bridge; the
         music app requests both build names' permission. -->
    <permission
        android:name="${applicationId}.permission.MUSIC_BRIDGE"
        android:protectionLevel="signature" />

    <application
        android:name=".Application"
        android:appComponentFactory="com.kidslauncher.mdm.KidAppComponentFactory"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/launcherBaseTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute"
        tools:replace="android:appComponentFactory">

        <!-- stateNotNeeded (kiosk-root, 2026-11-11): Home's record outlives its process' death even when it dies in
             front with no saved state (AOSP ActivityRecord.handleAppDied), so Home's task stays the kiosk's lock-task
             root. Without it the system removed Home's task at a kill or crash, started a new one at the END of the
             locked tasks, and a page task of ours left stopped (Kalender, Meldinger) became the root: Back could not
             leave it, and removing it cleared every locked task (kiosk-escapes-and-updates.md, "Home stays the
             lock-task root"; HomeFrontTest). -->
        <activity
            android:name=".ui.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/launcherHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.list.AppListActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LegalInfoActivity"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".ui.LockActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- Handy's own PIN lock (step 10): its own task over everything, shown over the keyguard
             (unmigrated phones), portrait (a rotation must not cost a re-front), never in recents.
             Not direct-boot-aware: the kid PIN lives in CE storage, and nothing that starts lock
             task may run before the first unlock (the BFU lockout incidents in CLAUDE.md). -->
        <activity
            android:name=".lock.PinLockActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.pinlock"
            android:theme="@style/PinLockTheme" />
        <!-- Design 16b: the boot cover - a direct-boot-aware HOME with the breathing Vibb mark from
             the boot animation to the unlock, instead of the stock launcher. Own process (nothing
             of Application.onCreate runs there), framework theme, no CE storage, no lock task.
             Disabled in the manifest: the main process enables it only at ACTION_SHUTDOWN while
             the server switch boot_cover is on, and it disables itself once unlocked
             (lock.BootCover, lock.BootCoverPlan). Priority 0 - a non-privileged app can't go
             higher, and lower loses to a stock launcher before any preference is read. -->
        <activity
            android:name=".lock.BootCoverActivity"
            android:configChanges="uiMode"
            android:directBootAware="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:process=":bootcover"
            android:taskAffinity="${applicationId}.bootcover"
            android:theme="@style/BootCoverTheme">
            <intent-filter android:priority="0">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Design 17 (qa-16-17-code #2): wakes the screen for a VoIP ring - turnScreenOn is known
             at the start; it sits on the PIN lock in its task and finishes itself. -->
        <activity
            android:name=".lock.VoipWakeActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.pinlock"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:turnScreenOn="true" />
        <!-- Dagen (design 69): the kid's day, an event's own page, the kid's own event. Not exported. A task of its
             own (2026-10-27), as any app's: in Home's task it had no Recents card, and Home/Back were an in-task
             switch without Android's task-close animation. In Recents (no excludeFromRecents, no FLAG_SECURE).
             Each page is two entries, identical but for the theme (design 78 §12.2 R2; PageManifestTest): the
             night class and its empty light twin, so the starting window Android draws from the entry is in the
             kid's look. Only the launcher's own intent builders name them (ui/look/PageKind.kt): none is
             exported, and nothing outside the process may hold a variant's name (R7). -->
        <activity
            android:name=".ui.day.DayActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageNightTheme" />
        <activity
            android:name=".ui.day.LightDayActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageLightTheme" />
        <activity
            android:name=".ui.day.EventActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageNightTheme" />
        <activity
            android:name=".ui.day.LightEventActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageLightTheme" />
        <activity
            android:name=".ui.day.EventEditActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageNightTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.day.LightEventEditActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:taskAffinity="${applicationId}.day"
            android:theme="@style/KidPageLightTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.kidsettings.KidSettingsActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- The kid's ringtone / message sound picker (2026-11-04): our own list, never the system picker; not
             exported, so only Kid Settings opens it, and as our own page it runs in the launcher's lock task. -->
        <activity
            android:name=".ui.kidsettings.KidSoundPickerActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ui.quickcontrols.WifiNetworksActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.quickcontrols.BluetoothDevicesActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false" />

        <!-- Calls. The dialer role needs a DIAL activity (plain and tel:) and an exported
             InCallService with IN_CALL_SERVICE_UI; without them setDefaultDialerApplication
             throws. VIEW tel:/voicemail: and CALL_BUTTON are here too so links and the call
             button land in the phone book rather than the system keypad (QA #6; which handler
             wins is a device check). exported="true" on the services is safe: their
             android:permission means only Telecom can bind.
             Direct boot (task 15, 02-calls.md): the call services, the in-call screen, its
             notification receiver and BootCallReceiver are directBootAware, so calls are screened
             before the first unlock after a reboot, from a device-protected copy of the rules.
             Nothing else is - in particular not HomeActivity/LockActivity (the BFU lockout
             incidents in CLAUDE.md) and not the phone book. -->
        <activity
            android:name=".calls.PhoneBookActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
                <data android:scheme="voicemail" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The call log (design 12): Telecom's own missed-call notification opens it, and so
                 may other apps. Its own filter, plus a persistent preferred activity set in every
                 AppEnforcer.apply() and never cleared, so neither the system dialer's call log
                 (its full keypad) nor a chooser wins; while calls are unmanaged the phone book
                 passes it on to the system dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
        </activity>
        <!-- Telecom's SHOW_MISSED_CALLS_NOTIFICATION (design 12): with this receiver in the default
             dialer Telecom sends us the broadcast instead of posting its own notification. A
             protected broadcast sent with READ_PHONE_STATE as the receiver permission, so
             exported="true" without android:permission (as AOSP Dialer). Not directBootAware. -->
        <receiver
            android:name=".calls.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <!-- Only our own missed-call notification's delete intent (a swipe marks its calls read). -->
        <receiver
            android:name=".calls.MissedCallDismissReceiver"
            android:exported="false" />
        <!-- Unread counts for the home grid (design 05-ui-photos-i18n.md). Android binds it only
             once notification access is granted - no device-owner API exists for that, so it's
             `adb shell cmd notification allow_listener <package>/com.kidslauncher.mdm.badges.BadgeListenerService`
             at provisioning. Not directBootAware. -->
        <service
            android:name=".badges.BadgeListenerService"
            android:exported="true"
            android:label="@string/badges_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".calls.InCallActivity"
            android:directBootAware="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.call"
            android:theme="@style/InCallTheme"
            android:turnScreenOn="true" />
        <service
            android:name=".calls.KidInCallService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <!-- Screens incoming calls; Telecom binds the default dialer's screening service. -->
        <service
            android:name=".calls.KidCallScreeningService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <!-- Stops not-allowed outgoing calls before they're placed. Needs ROLE_CALL_REDIRECTION
             (adb at provisioning, or the system prompt from Home). -->
        <service
            android:name=".calls.KidCallRedirectionService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>
        <!-- Only our own notification PendingIntents (Answer / Hang up). -->
        <receiver
            android:name=".calls.CallActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Only gets the process up with the device-protected call policy loaded after a reboot;
             LOCKED_BOOT_COMPLETED is a protected broadcast, so exported="false" is fine. -->
        <receiver
            android:name=".calls.BootCallReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- QR/NFC device-owner provisioning on Android 12+ needs these two (AOSP
             DevicePolicyManager ACTION_GET_PROVISIONING_MODE / ACTION_ADMIN_POLICY_COMPLIANCE):
             exported, only startable by holders of BIND_DEVICE_ADMIN (the system), no UI.
             [needs device test: QR provisioning on the Jelly Star; adb stays the fallback] -->
        <activity
            android:name=".server.ProvisioningModeActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".server.PolicyComplianceActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".server.MdmDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_PASSWORD_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Not externally reachable - only ever triggered via the PendingIntent passed to
             PackageInstaller.Session.commit() in AppInstaller.kt, for every tracked app's
             install/update, including the launcher's own self-update. -->
        <receiver
            android:name=".server.AppInstallReceiver"
            android:exported="false" />

        <!-- Not externally reachable - only ever triggered via the PendingIntent passed to
             PackageInstaller.uninstall() in AppInstaller.kt. -->
        <receiver
            android:name=".server.AppUninstallReceiver"
            android:exported="false" />

        <!-- Not externally reachable - only ever triggered via the "Stop Ringing" action's own
             PendingIntent on the notification LocateCommands.ring() shows. -->
        <receiver
            android:name=".server.StopRingReceiver"
            android:exported="false" />

        <service
            android:name=".server.CommandListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control enforcement (device owner): screen-time and time-rule signals, policy sync" />
        </service>

        <!-- The backstop sync alarm (push/BackstopAlarm) - our own explicit PendingIntent only. -->
        <receiver
            android:name=".push.BackstopReceiver"
            android:exported="false" />
        <!-- Design 64 step 2: the safe zones' platform fences (LocationManager.addProximityAlert)
             and the crossing's confirming-fix alarm - explicit PendingIntents only (the fences'
             mutable ones held by system_server alone), never reachable from another app. -->
        <receiver
            android:name=".zones.ZoneAlertReceiver"
            android:exported="false" />
        <receiver
            android:name=".zones.ZoneConfirmReceiver"
            android:exported="false" />
        <receiver
            android:name=".zones.ZoneCheckReceiver"
            android:exported="false" />
        <!-- Handy step 11: the update fence's backstop check and the self-update window's wake-up -
             our own explicit PendingIntents only. -->
        <receiver
            android:name=".server.UpdateFenceReceiver"
            android:exported="false" />
        <receiver
            android:name=".server.SelfUpdateReceiver"
            android:exported="false" />
        <!-- "End now" on the Play install-mode notification - our own PendingIntent only. -->
        <receiver
            android:name=".play.InstallModeReceiver"
            android:exported="false" />
        <!-- "Be om mer tid" on the anchor's notification (design r13 §2.4) - our own PendingIntent only. -->
        <receiver
            android:name=".timerules.TimeAskReceiver"
            android:exported="false" />
        <!-- "Lock again" on a parent-PIN window's notification (design 24b) - our own PendingIntent only. -->
        <receiver
            android:name=".server.WindowRelockReceiver"
            android:exported="false" />
        <!-- Design 77 §6.1, §8.4: the SMS role's four components, each guarded by its system permission (roles.xml
             ROLE_SMS) - none direct-boot-aware (the platform holds messages until the first unlock). -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.MmsPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <service
            android:name=".sms.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <activity
            android:name=".sms.ComposeActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </activity>
        <!-- The platform's sent and delivery results, and the notification's Reply - our own PendingIntents only. -->
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />
        <!-- Design 77 step 3b. The platform's MMS download and send results - our own PendingIntents only. -->
        <receiver
            android:name=".sms.mms.MmsResultReceiver"
            android:exported="false" />
        <!-- D10, QA L3: where the platform's MMS service writes a download (a byte-capped pipe) and reads a send - not
             exported; one URI per request, granted for it by the telephony broker and revoked on its result. -->
        <provider
            android:name=".sms.mms.MmsFileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- D8, §8.2: MMS bytes are parsed, and pictures decoded, only here - an isolated process with no permissions, no
             network, no provider and none of our files, handing back strings and raw pixels (MmsParseManifestTest). -->
        <service
            android:name=".sms.parse.MmsParseService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":mmsparse" />
        <receiver
            android:name=".sms.SmsReplyReceiver"
            android:exported="false" />
        <!-- The kid's message screens (design 77 §6.7, step 2): the list, a thread and a received picture. Not exported
             (the role's ComposeActivity is the way in from other apps). A task of their own, as Dagen's: in Recents as
             "Meldinger", never destroyed with the lock's task. A thread follows the keyboard itself (edge to edge). -->
        <activity
            android:name=".ui.messages.MessagesActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.messages" />
        <activity
            android:name=".ui.messages.ThreadActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.messages"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.messages.PictureActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false"
            android:taskAffinity="${applicationId}.messages" />
        <!-- Design 79 §5.2: the kid's own picture of a contact (or of a contact request's draft) - the picker or the
             allowed camera, then the framing. Not exported; not a free screen for screen time. -->
        <activity
            android:name=".calls.KidPhotoActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="false" />
        <!-- "Del" on a received picture (§6.7): a one-shot read grant on a copy in cacheDir/share/ (deleted after an
             hour) - not exported, only what share_paths.xml names. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <!-- Answers market:// and play.google.com/store links (handy step 7): the device owner makes
             it their persistent preferred activity, which AOSP honours only when the activity
             declares matching filters. Passes the link on to Play while Play isn't suspended. -->
        <activity
            android:name=".play.PlayLinkBlockedActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/PlayLinkBlockedTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="play.google.com" />
                <data android:pathPrefix="/store" />
            </intent-filter>
        </activity>

        <!-- Not externally reachable despite the implicit-action intent-filter - MY_PACKAGE_REPLACED
             is a protected system broadcast only the OS can send, always targeted at the just-updated
             app itself. See PackageReplacedReceiver's own doc comment for why this exists. -->
        <!-- Clock/zone change + boot (handy step 6). Exported for the system broadcasts (all
             protected), and it takes nothing else (security review S-L7). Not direct-boot-aware:
             before unlock the call path reads the boot copy itself. -->
        <receiver
            android:name=".timerules.TimeRuleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- The time-rule boundary alarm (S-L7): only our own alarm targets it. -->
        <receiver
            android:name=".timerules.TimeRuleAlarmReceiver"
            android:exported="false" />
        <!-- The lock reminder's ping (lock_reminders "ping"): only our own alarm targets it. -->
        <receiver
            android:name=".calendar.ReminderPingReceiver"
            android:exported="false" />
        <!-- The flashlight's auto-off after 10 minutes (design 41): only our own alarm targets it. -->
        <receiver
            android:name=".torch.TorchOffReceiver"
            android:exported="false" />
        <receiver
            android:name=".server.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- On-device DNS filter - see KidVpnService.kt and this repo's CLAUDE.md. Only the OS may
             bind to a VpnService, enforced via BIND_VPN_SERVICE here (not a <uses-permission> -
             see the manifest permission block above). -->
        <service
            android:name=".server.KidVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local ad/content DNS filtering VPN" />
        </service>
        <!-- The music app's bridge (design 21 §2): a bound service, checked per call too. -->
        <service
            android:name="com.kidslauncher.mdm.music.MusicBridgeService"
            android:exported="true"
            android:permission="${applicationId}.permission.MUSIC_BRIDGE" />
    </application>
</manifest>