<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only: the release config (src/main/res/xml/network_security_config.xml, read its comment) - cleartext
  allowed app-wide since design 102 D15 (a), so the emulator loop's server at http://10.0.2.2 (docs/testing/emulator.md),
  which a debug build alone takes as the server address (ServerTransport.kt, EMULATOR_HOST), needs no entry of its own.
  Design 76: debug-overrides trust user-installed CAs too (Android applies them to a debuggable build only), so
  mitmproxy's CA on the emulator passes Android's validation and the certificate check is what refuses it. The release
  config never trusts a user CA (ServerTransportTest).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">tailnet-server.vibb.invalid</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
