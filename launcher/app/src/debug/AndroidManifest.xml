<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: the design 16d lock-task override hook (docs/testing/emulator.md §6e), the
     design 24b vault-key hook, the design 28 fake headset, design 77's MMS push and design 106's missed Element X call and design 108b's registration backdating. Merged
     into the debug manifest; the release build never sees this file (checkReleaseHasNoDebugHook,
     DebugHookAbsentTest). Exported for `adb shell am broadcast -n`, guarded by DUMP (shell holds it,
     apps don't). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.kidslauncher.mdm.lock.LockTaskOverrideReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 24b §7: deletes the parent PIN vault's key (the key-failure device check). -->
        <receiver
            android:name="com.kidslauncher.mdm.server.PinVaultKeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 28 §4: a fake Bluetooth headset connects (the listening window's device checks). -->
        <receiver
            android:name="com.kidslauncher.mdm.music.HeadsetDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 77 step 3b: an MMS push the emulator can't receive, and its fake MMS server. -->
        <receiver
            android:name="com.kidslauncher.mdm.sms.MmsDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 106 §8 step 9: a missed Element X call the emulator can't have. -->
        <receiver
            android:name="com.kidslauncher.mdm.calls.ElementCallDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 108b §11 L11: backdates an app-push registration's stamps (the 30-day rule's gate), never the clock. -->
        <receiver
            android:name="com.kidslauncher.mdm.push.up.UpDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
