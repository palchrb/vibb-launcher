<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: the design 16d lock-task override hook (docs/testing/emulator.md §6e), the
     design 24b vault-key hook, the design 28 fake headset, design 32's lock-up toggle and keyguard cover. Merged
     into the debug manifest; the release build never sees this file (checkReleaseHasNoDebugHook,
     DebugHookAbsentTest). Exported for `adb shell am broadcast -n`, guarded by DUMP (shell holds it,
     apps don't). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.kidslauncher.mdm.lock.LockTaskOverrideReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 24b §7: deletes the parent PIN vault's key (the key-failure device check). -->
        <receiver
            android:name="com.kidslauncher.mdm.server.PinVaultKeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 28 §4: a fake Bluetooth headset connects (the listening window's device checks). -->
        <receiver
            android:name="com.kidslauncher.mdm.music.HeadsetDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 32 §5 H2: the lock-up re-starts a lock that is on top, or skips it (the default). -->
        <receiver
            android:name="com.kidslauncher.mdm.lock.LockUpDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Design 32 step 2: the keyguard cover on or off (docs/testing/emulator.md §6k). -->
        <receiver
            android:name="com.kidslauncher.mdm.lock.KeyguardCoverDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
