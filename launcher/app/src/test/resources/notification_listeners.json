{
  "android_auto": "com.google.android.projection.gearhead",
  "policy": {"off": {"allow_android_auto": false}, "on": {"allow_android_auto": true}},
  "report": [
    {"package": "com.android.launcher3", "off": false, "system": true},
    {"package": "com.example.watch", "off": false, "system": false},
    {"package": "com.google.android.projection.gearhead", "off": true, "system": true}
  ],
  "report_none": [],
  "read": [
    {"case": "Vibb One left out, sorted, the hidden and the system ones marked", "own": "me.vibb.launcher", "enabled": ["me.vibb.launcher", "com.google.android.projection.gearhead", "com.example.watch", "com.android.launcher3"], "hidden": ["com.google.android.projection.gearhead"], "system": ["com.google.android.projection.gearhead", "com.android.launcher3"], "report": [{"package": "com.android.launcher3", "off": false, "system": true}, {"package": "com.example.watch", "off": false, "system": false}, {"package": "com.google.android.projection.gearhead", "off": true, "system": true}]},
    {"case": "the other build left out too, each once", "own": "me.vibb.launcher.debug", "enabled": ["me.vibb.launcher", "me.vibb.launcher.debug", "com.example.watch", "com.example.watch"], "hidden": [], "system": [], "report": [{"package": "com.example.watch", "off": false, "system": false}]},
    {"case": "only Vibb One", "own": "me.vibb.launcher", "enabled": ["me.vibb.launcher"], "hidden": [], "system": [], "report": []}
  ],
  "clean": [
    {"case": "the report as it is", "in": [{"package": "com.example.watch", "off": false, "system": false}], "out": [{"package": "com.example.watch", "off": false, "system": false}]},
    {"case": "off or system missing or not a boolean", "in": [{"package": "com.example.a"}, {"package": "com.example.b", "off": "yes", "system": 1}], "out": [{"package": "com.example.a", "off": false, "system": false}, {"package": "com.example.b", "off": false, "system": false}]},
    {"case": "not a package name, not an object, duplicates dropped", "in": [{"package": "<b>x</b>"}, "com.example.a", {"package": "com.example.c", "off": true, "system": true}, {"package": "com.example.c", "off": false}], "out": [{"package": "com.example.c", "off": true, "system": true}]},
    {"case": "extra keys dropped", "in": [{"package": "com.example.a", "off": false, "system": false, "label": "A"}], "out": [{"package": "com.example.a", "off": false, "system": false}]},
    {"case": "not a list", "in": {"package": "com.example.a"}, "out": null}
  ],
  "unknown": [
    {"case": "a reader the parent didn't give", "report": [{"package": "com.example.watch", "off": false, "system": false}], "known": [], "unknown": ["com.example.watch"]},
    {"case": "a catalog or allowed app", "report": [{"package": "com.example.watch", "off": false, "system": false}], "known": ["com.example.watch"], "unknown": []},
    {"case": "one Vibb hid", "report": [{"package": "com.example.watch", "off": true, "system": false}], "known": [], "unknown": []},
    {"case": "one that came with the phone", "report": [{"package": "com.android.launcher3", "off": false, "system": true}], "known": [], "unknown": []},
    {"case": "Android Auto, managed by Vibb, also when allowed", "report": [{"package": "com.google.android.projection.gearhead", "off": false, "system": false}], "known": [], "unknown": []}
  ]
}
