{
  "comment": "Design 127 §4.1, the launcher's own rules (AppAccessRulesTest): the grant plan (accessGrants) and the report's readings (accessReports). States: default, granted, denied. A grant is [package, permission]. same_signer: the packages signed with the launcher's own certificate (a row may name its own).",
  "own": "me.vibb.launcher.debug",
  "same_signer": ["me.vibb.launcher", "me.vibb.music"],
  "requested": {
    "io.element.android.x": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO", "android.permission.READ_CONTACTS", "android.permission.INTERNET"],
    "org.example.maps": ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.READ_CONTACTS", "android.permission.WRITE_CONTACTS"],
    "org.example.plain": ["android.permission.INTERNET"],
    "org.example.gallery": ["android.permission.READ_MEDIA_IMAGES", "android.permission.ACCESS_MEDIA_LOCATION"],
    "me.vibb.launcher.debug": ["android.permission.CAMERA", "android.permission.READ_CONTACTS"],
    "me.vibb.music": ["android.permission.RECORD_AUDIO"],
    "me.vibb.launcher": ["android.permission.CAMERA"]
  },
  "grants": [
    {"name": "each denied key's requested permissions, nothing else",
     "denied": {"io.element.android.x": ["microphone"], "org.example.maps": ["location", "contacts"]},
     "writes": [["io.element.android.x", "android.permission.RECORD_AUDIO", "denied"],
                ["org.example.maps", "android.permission.ACCESS_FINE_LOCATION", "denied"],
                ["org.example.maps", "android.permission.ACCESS_COARSE_LOCATION", "denied"],
                ["org.example.maps", "android.permission.READ_CONTACTS", "denied"],
                ["org.example.maps", "android.permission.WRITE_CONTACTS", "denied"]]},
    {"name": "Posisjon off for an app that asks only for the photos' location: that one denied",
     "denied": {"org.example.gallery": ["location"]},
     "writes": [["org.example.gallery", "android.permission.ACCESS_MEDIA_LOCATION", "denied"]]},
    {"name": "already denied: nothing written",
     "denied": {"io.element.android.x": ["microphone"]},
     "current": [["io.element.android.x", "android.permission.RECORD_AUDIO", "denied"]],
     "writes": []},
    {"name": "the parent's on clears any fix to default, never a grant",
     "denied": {},
     "current": [["io.element.android.x", "android.permission.RECORD_AUDIO", "denied"], ["org.example.maps", "android.permission.READ_CONTACTS", "granted"]],
     "writes": [["io.element.android.x", "android.permission.RECORD_AUDIO", "default"], ["org.example.maps", "android.permission.READ_CONTACTS", "default"]]},
    {"name": "a window lifts every key",
     "denied": {"io.element.android.x": ["camera", "contacts"]},
     "window": true,
     "current": [["io.element.android.x", "android.permission.CAMERA", "denied"], ["io.element.android.x", "android.permission.READ_CONTACTS", "denied"]],
     "writes": [["io.element.android.x", "android.permission.CAMERA", "default"], ["io.element.android.x", "android.permission.READ_CONTACTS", "default"]]},
    {"name": "no app_permissions: nothing written",
     "denied": null,
     "current": [["io.element.android.x", "android.permission.CAMERA", "denied"]],
     "writes": []},
    {"name": "no app_permissions in a window: every DENIED lifted",
     "denied": null,
     "window": true,
     "current": [["io.element.android.x", "android.permission.CAMERA", "denied"]],
     "writes": [["io.element.android.x", "android.permission.CAMERA", "default"]]},
    {"name": "a live call: a held permission waits, one not held is denied, per key",
     "denied": {"io.element.android.x": ["microphone", "contacts"], "org.example.maps": ["location"]},
     "call": true,
     "held": [["io.element.android.x", "android.permission.RECORD_AUDIO"], ["org.example.maps", "android.permission.ACCESS_FINE_LOCATION"]],
     "writes": [["io.element.android.x", "android.permission.READ_CONTACTS", "denied"],
                ["org.example.maps", "android.permission.ACCESS_COARSE_LOCATION", "denied"]],
     "waiting": [["io.element.android.x", "android.permission.RECORD_AUDIO"], ["org.example.maps", "android.permission.ACCESS_FINE_LOCATION"]]},
    {"name": "held but no call: denied at once",
     "denied": {"io.element.android.x": ["microphone"]},
     "held": [["io.element.android.x", "android.permission.RECORD_AUDIO"]],
     "writes": [["io.element.android.x", "android.permission.RECORD_AUDIO", "denied"]]},
    {"name": "ours and Vibb's own apps never, even when listed",
     "denied": {"me.vibb.launcher.debug": ["camera", "contacts"], "me.vibb.music": ["microphone"], "me.vibb.launcher": ["camera"]},
     "writes": []},
    {"name": "Vibb music signed by another key: every key it asks for denied, policy or none",
     "same_signer": ["me.vibb.launcher"],
     "denied": {},
     "writes": [["me.vibb.music", "android.permission.RECORD_AUDIO", "denied"]]},
    {"name": "Vibb music signed by another key, no app_permissions: still denied",
     "same_signer": ["me.vibb.launcher"],
     "denied": null,
     "writes": [["me.vibb.music", "android.permission.RECORD_AUDIO", "denied"]]},
    {"name": "Vibb music signed by another key in a window: lifted",
     "same_signer": ["me.vibb.launcher"],
     "denied": {},
     "window": true,
     "current": [["me.vibb.music", "android.permission.RECORD_AUDIO", "denied"]],
     "writes": [["me.vibb.music", "android.permission.RECORD_AUDIO", "default"]]}
  ],
  "reports": [
    {"name": "every requested permission denied", "requested": ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"],
     "states": {"android.permission.ACCESS_FINE_LOCATION": "denied", "android.permission.ACCESS_COARSE_LOCATION": "denied"},
     "report": [["location", "admin_denied"]]},
    {"name": "the photos' location alone, denied", "requested": ["android.permission.READ_MEDIA_IMAGES", "android.permission.ACCESS_MEDIA_LOCATION"],
     "states": {"android.permission.ACCESS_MEDIA_LOCATION": "denied"},
     "report": [["location", "admin_denied"]]},
    {"name": "one of two not yet denied: requested", "requested": ["android.permission.READ_CONTACTS", "android.permission.WRITE_CONTACTS"],
     "states": {"android.permission.READ_CONTACTS": "denied"},
     "report": [["contacts", "requested"]]},
    {"name": "a refusal wins", "requested": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA"],
     "states": {"android.permission.RECORD_AUDIO": "denied"}, "refused": ["microphone"],
     "report": [["camera", "requested"], ["microphone", "refused"]]},
    {"name": "asks for none", "requested": ["android.permission.INTERNET", "android.permission.GET_ACCOUNTS"],
     "report": []}
  ],
  "refused": [
    {"name": "a failed denial is refused", "before": [], "evaluated": [["a.b", "camera"]], "failed": [["a.b", "camera"]], "after": [["a.b", "camera"]]},
    {"name": "a pass that succeeds clears it", "before": [["a.b", "camera"]], "evaluated": [["a.b", "camera"]], "after": []},
    {"name": "a waiting key keeps it", "before": [["a.b", "camera"]], "evaluated": [["a.b", "camera"]], "waiting": [["a.b", "camera"]], "after": [["a.b", "camera"]]},
    {"name": "another package's pass keeps it", "before": [["a.b", "camera"]], "evaluated": [["c.d", "location"]], "after": [["a.b", "camera"]]}
  ]
}
