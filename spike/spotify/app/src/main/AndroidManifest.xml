<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Item 10 only (Web Playback SDK, Web API); App Remote talks to the Spotify app locally. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The log notes network changes (item 3: airplane mode, reboot offline). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The keep-alive switch: a foreground service like Vibb's playback service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- Spotify's package state (installed, hidden, suspended, stopped) for the log. -->
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".SpikeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_spike"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WebPlaybackActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The media-controls probe: getActiveSessions needs notification-listener access
             (adb shell cmd notification allow_listener ...). Logs Spotify's notifications'
             flags and channels only, never their text. -->
        <service
            android:name=".SpikeNotificationListener"
            android:exported="false"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
