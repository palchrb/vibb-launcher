# Copy to .env and fill in before running. Every setting is optional; defaults shown.
# (DEPLOY.md: "Choose how it's reachable" for the listeners and the admin gate, "Signing in and
# recovery" for the first password.)

# The first admin account, created on the first run only (ignored afterwards). Without a password
# here or in ADMIN_PASSWORD_FILE, a random one is written to data/initial-admin-password (0600) and
# the log names the file. Either way it must be changed at the first sign-in.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_FILE=

# DATABASE_URL=sqlite://data/kidphone.db

# The admin listener (the parent PWA, and the phones' API while ADMIN_DEVICE_API is on).
# BIND_ADDR=127.0.0.1:3100
# The phone listener: only /api/devices/* and /healthz. Unset: none.
# DEVICE_BIND_ADDR=127.0.0.1:3101
# off once every phone uses the phone listener (needs DEVICE_BIND_ADDR).
# ADMIN_DEVICE_API=on
# off: the admin listener answers only loopback and tailnet clients, everyone else gets 403.
# on: every client - the PWA then rests on the password and the 2FA code alone.
# ADMIN_PUBLIC=off
# Proxies whose X-Forwarded-For is believed: exact proxy addresses only, never a subnet with other
# hosts in it. Never point a TCP-level forwarder (socat, ssh -L, tailscale serve
# --tls-terminated-tcp, funnel --tcp, Caddy layer4) at the admin port: it sends no header, so every
# client it forwards looks local.
# TRUSTED_PROXIES=127.0.0.1,::1
# Behind tailscale serve only: the admin pages also need one of these Tailscale logins.
# ADMIN_TAILSCALE_USERS=
# Days an admin session lasts without use (1-365). Use 7 with ADMIN_PUBLIC=on.
# SESSION_INACTIVITY_DAYS=30
# An admin session ends this many days after its sign-in, however often it is used (1-3650).
# SESSION_MAX_DAYS=90

# Only for local testing over plain HTTP (the emulator loop): the session cookie loses Secure and
# is named "handy" instead of "__Host-handy". Never set it when a proxy serves HTTPS.
# INSECURE_COOKIES=true

# Where the launcher and this server are released (DEPLOY.md, "Launcher provisioning settings").
# Only server-vX.Y.Z releases count for the server's update check.
# SERVER_RELEASE_REPO=palchrb/vibb-launcher
# LAUNCHER_APK_URL=https://github.com/palchrb/vibb-launcher/releases/latest/download/kids-launcher-mdm.apk
# LAUNCHER_SIGNATURE_CHECKSUM=
# The phones' server address in the setup QR while Settings > Phone Setup has none saved (an address
# saved there wins; the page says which one is used). https://, or http:// to a Tailscale IP
# address (100.64.0.0/10, fd7a:115c:a1e0::/48; taken with a warning - a *.ts.net name needs https://).
# Any other http:// is ignored, and the phones refuse it too.
# PHONE_SERVER_URL=https://vibb.your-tailnet.ts.net

# The tailnet recovery address for a phone whose certificate check refuses this server (design 76,
# DEPLOY.md "Tailnet recovery address"): plain http:// to a Tailscale IP only, shown on the phone's
# Advanced page and in its Settings. Unset: the setup QR's address when it is one, else this box's
# tailnet address on a listener that answers it, when the server can tell.
# PHONE_RECOVERY_URL=http://100.101.102.103:3101

# Seconds between keepalives on the SSE command stream, which every phone holds (design 19).
# 5-240: must stay under the launcher's 300 s read timeout; anything else falls back to 240 (the
# default since 0.20.0; 120 before). A proxy in front of this server needs a read timeout of at
# least 300 s (DEPLOY.md).
# SSE_KEEPALIVE_SECS=240

# The admin pages' default language: en or nb. Used on the sign-in pages and stored as an account's
# language on its first signed-in request, ahead of the browser's Accept-Language; unset = the
# browser's language, else English. An account's own choice (Settings > Account) always wins.
# PWA_DEFAULT_LANG=en
# Your e-mail address or website, added to the User-Agent of the requests to MET Norway for the lock screen's
# weather (design 75). MET asks every client for a contact and may block one without; with it MET can tie the
# grid cells (about 2 km) it is asked for to that address.
# 3-100 printable ASCII characters (no æ, ø, å), no quotes; anything else is ignored with a log line.
# MET_CONTACT=ola@example.org
