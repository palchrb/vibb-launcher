# Copy to .env and fill in before running.

# Bootstrap admin account, created on first run only (ignored afterward).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# Optional overrides - defaults shown.
# DATABASE_URL=sqlite://data/kidphone.db
# BIND_ADDR=127.0.0.1:3100

# Only set this for local LAN/HTTP testing - session cookies won't be sent
# over plain HTTP otherwise. Never set this in production (HTTPS via
# Tailscale Funnel or similar).
# INSECURE_COOKIES=true

# Where the launcher and this server are released - defaults shown (DEPLOY.md, "Launcher
# provisioning settings"). Only server-vX.Y.Z releases count for the server's update check.
# SERVER_RELEASE_REPO=palchrb/vibb-launcher
# LAUNCHER_APK_URL=https://github.com/palchrb/vibb-launcher/releases/latest/download/kids-launcher-mdm.apk
# LAUNCHER_SIGNATURE_CHECKSUM=

# Seconds between keepalives on the SSE command stream, which every phone holds (design 19).
# 5-240: must stay under the launcher's 300 s read timeout; anything else falls back to 120. A proxy
# in front of this server needs a read timeout of at least 300 s (DEPLOY.md).
# SSE_KEEPALIVE_SECS=120
