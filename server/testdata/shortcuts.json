{
  "capability": "shortcuts_v1",
  "bit": 128,
  "max_items": 4,
  "items": [
    {"key": "torch", "bit": null, "nb": "Lommelykt", "en": "Flashlight"},
    {"key": "sound", "bit": 8, "nb": "Lyd", "en": "Sound"},
    {"key": "airplane", "bit": 64, "nb": "Flymodus", "en": "Airplane mode"},
    {"key": "wifi", "bit": 1, "nb": "Wi-Fi", "en": "Wi-Fi"},
    {"key": "bluetooth", "bit": 2, "nb": "Bluetooth", "en": "Bluetooth"},
    {"key": "mobile_data", "bit": 32, "nb": "Mobildata", "en": "Mobile data"},
    {"key": "brightness", "bit": 4, "nb": "Lysstyrke", "en": "Brightness"},
    {"key": "more_time", "bit": null, "nb": "Mer tid", "en": "More time"},
    {"key": "music", "bit": null, "nb": "Musikk", "en": "Music"}
  ],
  "defaults": ["torch", "sound", "airplane", "wifi", "bluetooth", "mobile_data", "brightness", "more_time", "music"],
  "report": {"shown": true, "hidden": false, "items": ["torch", "sound", "airplane", "wifi"]},
  "report_hidden": {"shown": false, "hidden": true, "items": ["torch", "sound"]},
  "clean": [
    {"case": "the report as it is", "in": {"shown": true, "hidden": false, "items": ["torch", "sound", "airplane", "wifi"]}, "out": {"shown": true, "hidden": false, "items": ["torch", "sound", "airplane", "wifi"]}},
    {"case": "unknown keys and duplicates dropped", "in": {"shown": true, "hidden": false, "items": ["torch", "laser", "torch", "sound"]}, "out": {"shown": true, "hidden": false, "items": ["torch", "sound"]}},
    {"case": "cut to four", "in": {"shown": true, "hidden": false, "items": ["music", "more_time", "brightness", "mobile_data", "bluetooth", "wifi"]}, "out": {"shown": true, "hidden": false, "items": ["music", "more_time", "brightness", "mobile_data"]}},
    {"case": "hidden is never shown", "in": {"shown": true, "hidden": true, "items": ["wifi"]}, "out": {"shown": false, "hidden": true, "items": ["wifi"]}},
    {"case": "flags missing or not booleans", "in": {"shown": "yes", "items": ["wifi"]}, "out": {"shown": false, "hidden": false, "items": ["wifi"]}},
    {"case": "items not a list", "in": {"shown": true, "hidden": false, "items": "torch"}, "out": {"shown": true, "hidden": false, "items": []}},
    {"case": "entries that aren't strings dropped", "in": {"shown": true, "hidden": false, "items": ["wifi", 3, null, "music"]}, "out": {"shown": true, "hidden": false, "items": ["wifi", "music"]}},
    {"case": "extra keys dropped", "in": {"shown": false, "hidden": false, "items": [], "grid": true}, "out": {"shown": false, "hidden": false, "items": []}},
    {"case": "not an object", "in": "torch", "out": null},
    {"case": "a list", "in": ["torch"], "out": null}
  ]
}
