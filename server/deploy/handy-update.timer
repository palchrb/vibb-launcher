# Runs handy-update.service (update-image.sh --auto) once a day at a quiet hour, the host's local time
# (server/DEPLOY.md, "Automatic, verified"). Persistent: a run missed while the host was off happens at its next boot.
[Unit]
Description=Vibb Phone server: daily verified image update

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
