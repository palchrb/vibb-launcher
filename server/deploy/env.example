# .env for compose.yaml - copy to .env next to it. Every setting: server/DEPLOY.md, sections 2 and
# "Launcher provisioning settings".

# The release to run (a server-v* tag without the prefix). `latest` works too, but a pinned version updates
# only when you change it.
HANDY_VERSION=0.24.0

# Backups and the update check run on local time; the image is UTC otherwise.
TZ=Europe/Oslo

# The admin listener (the parent app) and the phone listener, both on loopback: Caddy or `tailscale serve`
# puts HTTPS in front (Caddyfile.example).
BIND_ADDR=127.0.0.1:3100
DEVICE_BIND_ADDR=127.0.0.1:3101

# Off: the parent app answers only loopback and tailnet clients. Keep it off unless you have read
# server/DEPLOY.md, "Three ways to expose it", option (b).
ADMIN_PUBLIC=off

# Once every phone uses the phone listener's URL, turn this off.
ADMIN_DEVICE_API=on

# The launcher's signing certificate checksum for the setup QR (Settings > Phone Setup shows how to get it).
LAUNCHER_SIGNATURE_CHECKSUM=

# The phones' server address in the setup QR while Settings > Phone Setup has none saved (an address
# saved there wins). https://; http:// to a Tailscale address (100.x, fd7a:115c:a1e0::, *.ts.net);
# http:// to another private address only through an encrypted tunnel (taken with a warning, the
# server can't tell); http:// to a public host is ignored.
# PHONE_SERVER_URL=https://vibb.your-tailnet.ts.net
