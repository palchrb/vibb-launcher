# The old standalone clones of the two forks, from before they were imported into launcher/ and
# server/ (2026-10-05). Kept locally for reference only; never edit or commit them.
/kids-launcher-mdm/
/kid-phone-server/

# scripts/smoke-test.sh screenshots (default OUT_DIR).
smoke-*/

# Signing keys never go into the repo (security review L10): Android keystores, PKCS#12, raw
# keys - and the server's minisign secret key (server/DEPLOY.md, "Release signing").
*.jks
*.keystore
*.p12
*.pk8
*.key

# Python bytecode (scripts/fake-sonos.py run without -B).
__pycache__/
