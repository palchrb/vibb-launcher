<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: the step-2 debug feed (design 21 §6, docs/testing/emulator.md). Merged into
     the debug manifest; the release build never sees this file (checkReleaseHasNoDebugFeed,
     SourceScanTest). Exported for `adb shell am broadcast -n`, guarded by DUMP (the shell
     holds it, apps don't). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="me.vibb.music.debugfeed.DebugFeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- The fake Storytel's and the fake Spotify's bases (design 26b §4.6, 26c §9.3) from the feed's
             config.json at every process start, before WorkManager's own provider can start a download job
             (a higher initOrder is created first). -->
        <provider
            android:name="me.vibb.music.debugfeed.DebugStartup"
            android:authorities="${applicationId}.debugstartup"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
