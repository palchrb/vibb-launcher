<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of ours leaves the phone through backup or device transfer (security review 2026-10-21 P-L3): the
     positions, favourites and played times (databases/), the library, listings and covers (files/), and the web
     player's cookies and storage. allowBackup="false" stops cloud backup; device-to-device transfer ignores it on
     Android 12+, so every domain is excluded here as well, as the launcher does. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
