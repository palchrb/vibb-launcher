<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window is the night ground, edge to edge. -->
    <style name="Theme.VibbMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vibb_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- The launch splash (Android 12+; minSdk 34): the Vibb mark alone on the night ground (scripts/music-splash.py),
             static. No branding image: Android pins it to the screen's foot, and the wordmark sits right under the rings
             in the app's first frame instead, which this splash fades into (MainActivity, logic/Splash.kt). -->
        <item name="android:windowSplashScreenBackground">@color/vibb_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vibb_mark</item>
    </style>
</resources>
