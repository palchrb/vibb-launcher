<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window is the night ground, edge to edge. -->
    <style name="Theme.VibbMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vibb_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- The launch splash (Android 12+; minSdk 34): the Vibb mark on the night ground and the wordmark at the
             foot, both from scripts/music-splash.py; the system's own fade is the only motion. MainActivity keeps it up
             until the first content frame (logic/Splash.kt). -->
        <item name="android:windowSplashScreenBackground">@color/vibb_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vibb_mark</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_wordmark</item>
    </style>
</resources>
